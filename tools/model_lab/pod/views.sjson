	{name = "inside_door", position = [1.6, 0, 0.8], target = [-1, 0, 1], field_of_view_degrees = 80}
	{name = "inside_wide", position = [-1.5, 0, 1.4], target = [1, 0, 0.9], field_of_view_degrees = 80}
]
