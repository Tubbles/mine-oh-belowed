// The touch overlay (work item 0115, src/touch_overlay.odin, doc/input.md):
// a virtual gamepad the game draws on a touch screen. Its buttons press
// gamepad controls, so data/bindings.sjson maps them to actions like any
// gamepad's.
//
// Lengths are pixels of a screen reference_height pixels high and scale
// with the screen's height, so a wider screen keeps the buttons in the
// corners where the thumbs are. Each element:
//   kind      button, stick or look
//   button:
//     control   a gamepad control as bindings.sjson spells it: SOUTH, EAST,
//               WEST, NORTH, BACK, START, LEFT_STICK, RIGHT_STICK,
//               LEFT_SHOULDER, RIGHT_SHOULDER, DPAD_UP, DPAD_DOWN,
//               DPAD_LEFT, DPAD_RIGHT, LEFT_TRIGGER, RIGHT_TRIGGER
//     shape     rectangle or circle
//     anchor    top_left, top_right, bottom_left, bottom_right,
//               bottom_center or top_center
//     position  the centre from the anchor's corner, x and y towards the
//               screen's middle; for bottom_center and top_center x is the
//               offset from the centre line, negative to the left
//     size      width and height (a circle's diameter twice)
//     label     drawn on the button and named in load errors
//   stick: side (left or right, the half of the screen a touch that
//     begins on no button turns into the stick, centred where it began),
//     radius (the drag that gives a full stick; the input backend's stick
//     dead zone applies as for any stick) and sprint_rim (the drag over
//     the radius at which the stick starts to hold LEFT_STICK, Sprint:
//     the first crossing within 45 degrees of straight up holds it until
//     the finger lifts)
//   look: side (the half whose drags turn the view) and sensitivity (the
//     drag's pixels are multiplied by it and added as mouse pixels), and
//     the controls of the tap scheme (work item 0118, the touch_interaction
//     setting), each a control as a button's: hold_control (held while a
//     finger rests on the half, aimed at the finger: Mine),
//     tap_interact_control (pressed by a tap on a target that takes
//     Interact) and tap_place_control (pressed by a tap on anything else:
//     Place)
//
// hotbar_drop_control (work item 0119): the control a long press on the
// selected hotbar slot holds until the finger lifts, a control as a
// button's (DPAD_DOWN: Drop_Stack through the bindings).
//
// The layout is GameNative's (a 2424 by 1080 screenshot of 2026-09-29)
// without its d-pad, whose half belongs to the stick, and without R3.
// Back and Start sit at the top centre instead of GameNative's bottom
// centre, where the hotbar is.
reference_height = 1080
hotbar_drop_control = "DPAD_DOWN"
elements = [
	{kind = "button" control = "LEFT_TRIGGER" shape = "rectangle" anchor = "top_left" position = [181.5, 85] size = [363, 170] label = "LT"}
	{kind = "button" control = "RIGHT_TRIGGER" shape = "rectangle" anchor = "top_right" position = [181.5, 85] size = [363, 170] label = "RT"}
	{kind = "button" control = "LEFT_SHOULDER" shape = "rectangle" anchor = "top_left" position = [85, 238] size = [170, 100] label = "LB"}
	{kind = "button" control = "RIGHT_SHOULDER" shape = "rectangle" anchor = "top_right" position = [85, 238] size = [170, 100] label = "RB"}
	{kind = "button" control = "NORTH" shape = "circle" anchor = "top_right" position = [312, 287] size = [146, 146] label = "Y"}
	{kind = "button" control = "WEST" shape = "circle" anchor = "top_right" position = [457, 431] size = [146, 146] label = "X"}
	{kind = "button" control = "EAST" shape = "circle" anchor = "top_right" position = [172, 431] size = [146, 146] label = "B"}
	{kind = "button" control = "SOUTH" shape = "circle" anchor = "top_right" position = [312, 575] size = [146, 146] label = "A"}
	{kind = "button" control = "LEFT_STICK" shape = "circle" anchor = "bottom_left" position = [121, 290] size = [120, 120] label = "L3"}
	{kind = "button" control = "BACK" shape = "rectangle" anchor = "top_center" position = [-99, 60] size = [163, 79] label = "Back"}
	{kind = "button" control = "START" shape = "rectangle" anchor = "top_center" position = [92, 60] size = [163, 79] label = "Start"}
	{kind = "stick" side = "left" radius = 130 sprint_rim = 1.25}
	{kind = "look" side = "right" sensitivity = 1.0 hold_control = "RIGHT_TRIGGER" tap_interact_control = "SOUTH" tap_place_control = "LEFT_TRIGGER"}
]
