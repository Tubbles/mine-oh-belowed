// The touch overlay (work item 0115, src/touch_overlay.odin, doc/touch_overlay.md):
// a virtual gamepad the game draws on a touch screen. Its stick, its
// gestures and any buttons press gamepad controls, so data/bindings.sjson
// maps them to actions like any gamepad's.
//
// Lengths are pixels of a screen reference_height pixels high and scale
// with the screen's height, so a wider screen keeps the buttons in the
// corners where the thumbs are. Each element:
//   kind      button, stick or look
//   button:
//     control   a gamepad control as bindings.sjson spells it: SOUTH, EAST,
//               WEST, NORTH, BACK, START, LEFT_STICK, RIGHT_STICK,
//               LEFT_SHOULDER, RIGHT_SHOULDER, DPAD_UP, DPAD_DOWN,
//               DPAD_LEFT, DPAD_RIGHT, LEFT_TRIGGER, RIGHT_TRIGGER
//     shape     rectangle or circle
//     anchor    top_left, top_right, bottom_left, bottom_right,
//               bottom_center or top_center
//     position  the centre from the anchor's corner, x and y towards the
//               screen's middle; for bottom_center and top_center x is the
//               offset from the centre line, negative to the left
//     size      width and height (a circle's diameter twice)
//     label     drawn on the button and named in load errors
//     double_tap_toggles  (work item 0120, false when left out) a touch
//               landing within 0.3 seconds of a tap's lift (a tap: down
//               less than 0.25 seconds) latches the button down until
//               the next tap; a single tap presses it as usual. On a B
//               (Sneak) button, double tapping keeps sneaking. Latching works
//               only while the sneak setting is Hold, where a tap does
//               not already toggle
//   stick: side (left or right, the half of the screen where a touch that
//     begins on no button turns into the stick once it moves, centred
//     where it began),
//     radius (the drag that gives a full stick; the input backend's stick
//     dead zone applies as for any stick) and sprint_rim (the drag over
//     the radius at which the stick starts to hold LEFT_STICK, Sprint:
//     the first crossing within 45 degrees of straight up holds it until
//     the finger lifts), and static (work item 0120, false when left
//     out): a static stick has anchor and position like a button (its
//     base's centre) and reads only a touch that begins inside its base
//     circle, centred on the base; a touch elsewhere on its half is free
//     screen like the rest. A floating stick takes no anchor or
//     position. The loader cannot tell position = [0, 0] from no
//     position, so a static stick needs a non zero position and a
//     floating stick leaves it out.
//   look: side (kept for the file's form: since work item 0134 a drag
//     anywhere off the stick turns the view) and sensitivity (the drag's
//     pixels are multiplied by it and added as mouse pixels), and the
//     controls of the gestures (work item 0118), each a control as a
//     button's: hold_control (held while a finger rests on free screen:
//     Mine), tap_interact_control (pressed by a tap on a target that takes
//     Interact), tap_open_control (work item 0194, pressed by a tap on
//     another machine with a panel: Open_Inventory's WEST, which the game
//     turns into opening that machine; WEST when left out) and
//     tap_place_control (pressed by a tap on anything else: Place), and
//     jump_zone_share (work item 0134, 0 or left out for none, below 1):
//     a tap in that share of the screen's width at the right edge
//     presses the Jump action itself instead, aimed nowhere (not SOUTH,
//     which is Interact too)
//
// Every element also takes opacity (work item 0121, 0.1 to 1, 1 when left
// out): its drawing's alpha, times the overlay's own. The loader cannot
// tell opacity = 0 from no opacity, so 0 counts as 1.
//
// This file's layout is the one called Default. The touch layout editor
// (Accessibility, Edit touch layout) never changes it: it saves copies to
// touch_overlay.sjson in the user configuration directory, in this file's
// form under a name each (doc/touch_overlay.md, User layouts and the
// editor), and a reload of this file keeps applying to Default. A saved layout needs no START
// button: the HUD's pause button beside the hotbar opens the pause menu.
//
// hotbar_drop_control (work item 0119): the control a long press on the
// selected hotbar slot holds until the finger lifts, a control as a
// button's (DPAD_DOWN: Drop_Stack through the bindings).
//
// The layout has no buttons (work item 0134): taps and holds anywhere
// place and mine, a tap at the right edge jumps, the stick's rim sprints,
// the hotbar's taps and long press select and drop, and the HUD's touch
// buttons beside the hotbar open the inventory, the map and the pause
// menu and rotate. Sneak has no touch control; a user layout may add a B button.
reference_height = 1080
hotbar_drop_control = "DPAD_DOWN"
elements = [
	{kind = "stick" side = "left" radius = 130 sprint_rim = 1.25}
	{kind = "look" side = "right" sensitivity = 1.0 hold_control = "RIGHT_TRIGGER" tap_interact_control = "SOUTH" tap_place_control = "LEFT_TRIGGER" tap_open_control = "WEST" jump_zone_share = 0.2}
]
