// Chapter 1, Arrival (doc/quests.md, Chapters), one quest per beat.
// Chapters load in file name order and play in sequence, one active quest
// at a time.
//
// A quest: id, title_key, text_key (the objective text), objectives,
// message_key (Mission Control when the quest becomes active) and
// complete_key (when it is done), both optional, hints, rewards, and
// main for the chapter's main quest (at most one per chapter). Every key
// names a string in data/strings/en.sjson.
//
// Objective types and their parameters:
//   obtain    item, count      what players came to hold (mined, taken, crafted)
//   craft     item, count      crafted by hand or smelted; with
//             produced_since_active = true only what was made after the
//             quest became active counts
//   place     entity, count    placements of a machine from machines.sjson;
//             or item, count   blocks placed with an item that places one
//                              (concrete, slag heaps)
//   sustain   item, rate_per_minute, minutes and/or seconds, hands_off
//                              produced at the rate for that long without a
//                              break (and, hands_off, without a world action).
//                              Windows are seconds, not minutes: a quest that
//                              makes the player wait is not fun (user, 2026-09-27)
//   research  technology      marked researched; an infinite technology
//                              counts once its first level is done
//   deliver   item, count      put into the capsule on the landing pad,
//                              taken out when the quest completes
//   discover  recipe           the recipe is available
//   walk      count            blocks walked on foot
//   counter   counter, label_key, count
//                              growth of a hint counter (below, except
//                              mining_ticks); label_key is the journal text
//   produce_fluid  fluid, litres
//                              litres of a fluid put into machine ports by
//                              pumps, boilers and crafting machines
//   ship      item, count      items rockets carried away; without an item
//             or count         every item shipped counts
// obtain, craft, place, walk and ship count since the game began; deliver,
// counter, produce_fluid and craft with produced_since_active count from
// the moment the quest became active.
//
// A hint fires once, when its counter has grown by threshold since its
// quest became active: blocks_mined, mining_ticks (with block, in ticks
// at 60 per second), distance_walked (blocks), furnace_out_of_fuel and
// furnace_output_full (times a furnace stalled), fuel_burned (items),
// inventory_full_ticks (ticks with no empty inventory slot),
// inserter_out_of_fuel and inserter_waiting_for_room (times an inserter
// stalled), inserter_idle_ticks (ticks an inserter had nothing to pick,
// summed over inserters), drill_out_of_fuel and drill_waiting_for_room
// (times a drill stalled), vein_exhausted (veins drained by drills),
// belt_dead_end_ticks (ticks a line's front item stood at a dead end no
// inserter picks from, summed over lines), inserter_idle_a_minute (times
// an inserter reached a minute of uninterrupted idling),
// drill_fuel_burned (fuel items lit by drills), brownout_ticks (ticks
// some power network was below full satisfaction), unpowered_machine_ticks
// (electric machines outside every power network, summed over ticks),
// recycled (items recyclers took, counted when a recycling craft ends),
// mixing_refusals (times a machine's fluid port closed because the
// network's fluid would mix with it), flared_litres (gas flare stacks
// burned), generator_gas_litres (gas combustion generators drew),
// schematics_found (schematics read whose recipe was new), veins_assayed,
// core_samples_taken, seismic_shots and veins_resolved (prospecting),
// bore_drill_units (units bore drills put out),
// bore_drill_no_vein_attempts (times Place was refused only because no
// deep vein lies below a bore drill), turbine_kilojoules (energy hydro
// turbines gave their networks), turbine_still_water_ticks (times a
// hydro turbine reached ten seconds in a row with no flowing water),
// contracts_late (contracts fulfilled after their deadline),
// credit_earned (venture credit from free trade) and surveys_bought (every
// orbital survey run, contract rewards included).
// A hint with on_activation = true and no counter or threshold fires as
// soon as its quest becomes active.
//
// A reward is {item, count}, landing in the capsule, {unlocks_recipe}
// for a recipe of the quest channel, or {unlocks_technology}, which marks
// the technology researched (the quest_gate technologies
// the labs refuse).
id = "chapter_01"
title_key = "chapter_01_title"
quests = [
	{
		id = "arrival"
		title_key = "quest_arrival_title"
		text_key = "quest_arrival_text"
		objectives = []
		message_key = "mc_arrival"
	}
	{
		id = "bearings"
		title_key = "quest_bearings_title"
		text_key = "quest_bearings_text"
		objectives = [
			{type = "walk", count = 10}
		]
		complete_key = "mc_bearings_done"
	}
	{
		id = "timber"
		title_key = "quest_timber_title"
		text_key = "quest_timber_text"
		objectives = [
			{type = "obtain", item = "log", count = 10}
		]
		message_key = "mc_timber"
		hints = [
			{counter = "mining_ticks", block = "grass", threshold = 120, text_key = "mc_hint_grass"}
		]
	}
	{
		id = "tools"
		title_key = "quest_tools_title"
		text_key = "quest_tools_text"
		objectives = [
			{type = "craft", item = "plank", count = 4}
			{type = "craft", item = "stick", count = 4}
			{type = "craft", item = "wooden_pickaxe", count = 1}
		]
		message_key = "mc_tools"
	}
	{
		id = "stone"
		title_key = "quest_stone_title"
		text_key = "quest_stone_text"
		objectives = [
			{type = "obtain", item = "stone", count = 20}
		]
		message_key = "mc_stone"
	}
	{
		id = "rocks"
		title_key = "quest_rocks_title"
		text_key = "quest_rocks_text"
		objectives = [
			{type = "obtain", item = "hematite", count = 10}
		]
		message_key = "mc_rocks"
		complete_key = "mc_rocks_done"
	}
	{
		id = "furnace"
		title_key = "quest_furnace_title"
		text_key = "quest_furnace_text"
		objectives = [
			{type = "craft", item = "stone_furnace", count = 1}
			{type = "place", entity = "stone_furnace", count = 1}
		]
		message_key = "mc_furnace"
	}
	{
		id = "fire"
		title_key = "quest_fire_title"
		text_key = "quest_fire_text"
		objectives = [
			{type = "craft", item = "iron_plate", count = 1}
		]
		hints = [
			{counter = "fuel_burned", threshold = 1, text_key = "mc_smelting"}
		]
	}
	{
		id = "stock"
		title_key = "quest_stock_title"
		text_key = "quest_stock_text"
		objectives = [
			{type = "obtain", item = "iron_plate", count = 10}
		]
		message_key = "mc_stock"
		complete_key = "mc_stock_done"
		rewards = [
			{item = "coal", count = 50}
			{item = "iron_plate", count = 10}
		]
		main = true
	}
]
