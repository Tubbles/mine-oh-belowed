	{
		id = "sixty"
		title_key = "quest_sixty_title"
		text_key = "quest_sixty_text"
		objectives = [
			{type = "sustain", item = "iron_plate", rate_per_minute = 60, seconds = 30}
		]
		message_key = "mc_sixty"
		complete_key = "mc_sixty_done"
	}
	{
		id = "launch_pad_permit"
		title_key = "quest_launch_pad_permit_title"
		text_key = "quest_launch_pad_permit_text"
		objectives = [
			{type = "deliver", item = "aluminium_plate", count = 100}
			{type = "deliver", item = "silicon", count = 50}
		]
		message_key = "mc_launch_pad_permit"
		complete_key = "mc_launch_pad_permit_done"
		rewards = [
			{unlocks_technology = "rocket_program"}
			{item = "steel", count = 200}
			{item = "plastic_bar", count = 100}
		]
		main = true
	}
]
