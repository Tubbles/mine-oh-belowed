// The sound table (work item 0068). Every sound the game plays is listed
// here: id is what the game asks for, file the .wav under data/sounds/
// (16 bit PCM), volume its level from 0 to 1 before the settings'
// volumes, kind "effect" (short, played once, never repeated within 40
// milliseconds) or "loop" (streamed and faded in and out by the mixer).
// Effects scale with the effects volume, loops with the ambience volume,
// both with the master volume.
// Ids the game asks for:
// footstep_<material> for every sound_material of data/blocks.sjson
// (stone is the default and must exist); mine_hit_<tier> for the tool
// tiers, the highest listed tier at or below the player's taking over;
// block_break, block_place; ui_move, ui_confirm, ui_back; hum_burner,
// hum_electric, hum_fluid (the nearest working machine by family);
// ambience_<name> for every ambience of data/biomes.sjson; rain;
// rocket_launch, capsule_landing, discovery_chime; mission_control_chime
// (a Mission Control line starting on the HUD, work item 0069).
// The placeholder files are written by tools/make_placeholder_sounds.py.
sounds = [
	{id = "footstep_stone", file = "footstep_stone.wav", volume = 0.5, kind = "effect"}
	{id = "footstep_dirt", file = "footstep_dirt.wav", volume = 0.5, kind = "effect"}
	{id = "footstep_sand", file = "footstep_sand.wav", volume = 0.45, kind = "effect"}
