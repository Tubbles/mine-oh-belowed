// Surface veins (work item 0006); the rules behind these numbers are in
// doc/content.md "Veins". Veins are placed per region of 8 by 8 chunk
// columns (256 by 256 blocks). Every footprint lies wholly inside its
// region.
//
// size_classes: units are the vein's total output before the richness
// factor, split over the vein type's outputs by percent. Each region holds
// minimum_per_region to maximum_per_region veins of the class, and none at
// all when the region centre is closer than minimum_distance blocks to the
// world origin. radius is the footprint disc on the surface, in blocks.
//
// Richer and larger farther from spawn: at a distance d from the world
// origin, units are multiplied by 1 + d / richness_distance and the radius
// grows by one block per richness_distance, at most maximum_radius_growth.
richness_distance = 2048
maximum_radius_growth = 3
// What the outcrop of an exhausted finite vein turns into (work item 0016).
spent_block = "spent_rock"
// Deep veins (work item 0035): a second placement pass per region with its
// own seed, using the size classes above with deep_units_factor times the
// units (doc/content.md: five times the surface class) and the vein types
// flagged deep = true. A deep vein has no outcrop; its centre lies
// deep_minimum_depth to deep_maximum_depth blocks below the surface at the
// disc centre, and a bore drill standing on the surface over its disc taps
// it.
deep_units_factor = 5
deep_minimum_depth = 40
deep_maximum_depth = 120

size_classes = [
	{
		id = "scattering"
		minimum_units = 2000
		maximum_units = 5000
		minimum_radius = 3
		maximum_radius = 5
		minimum_per_region = 3
		maximum_per_region = 6
		minimum_distance = 0
	}
	{
		id = "deposit"
		minimum_units = 20000
		maximum_units = 60000
		minimum_radius = 6
		maximum_radius = 9
		minimum_per_region = 0
		maximum_per_region = 2
		minimum_distance = 0
	}
	{
		id = "concentration"
		minimum_units = 100000
		maximum_units = 300000
		minimum_radius = 10
		maximum_radius = 14
		minimum_per_region = 0
		maximum_per_region = 1
		minimum_distance = 1024
	}
]

// weight: relative chance among the types allowed in the biome at the vein
// centre. biomes: biome ids the type may appear in, empty for everywhere.
// outcrop_blocks: the surface blocks of the footprint, alternating in a
// checkerboard when there are several. name_key: the vein type's name in
// data/strings/en.sjson. outputs: the ore items a drill draws, by percent.
// low_grade (work item 0026, optional) names the ore's low grade twin: a
// drawn ore unit comes out low grade with a share that rises from 10
// percent at a full reservoir to 60 percent with 5 percent left (10
// percent throughout on infinite veins). Spoils and coal have none.
// Lead, zinc and nickel (phase 5) keep to the hills, desert and forest
// with lower weights, a guess pending the couch tests. The climate biomes
// (work item 0058) each lean to at least one type: coal in the steppe and
// the wetland, lead in the highland, zinc and nickel in the badlands,
// nickel in the cold barrens and the coastal dunes.
// deep = true (work item 0035) makes a deep vein type: placed only by the
// deep pass, never by the surface one, with no outcrop_blocks. Deep types
// are richer and carry the rarer ores (bauxite, gold in quartz); their
// mixes and weights are guesses pending the couch tests.
vein_types = [
	{
		id = "iron"
		name_key = "vein_type_iron"
		weight = 30
		biomes = []
		outcrop_blocks = ["hematite_ore"]
		outputs = [{ore = "hematite", low_grade = "hematite_low_grade", percent = 80}, {ore = "gravel", percent = 20}]
	}
	{
		id = "copper"
		name_key = "vein_type_copper"
		weight = 25
		biomes = []
		outcrop_blocks = ["chalcopyrite_ore"]
		outputs = [{ore = "chalcopyrite", low_grade = "chalcopyrite_low_grade", percent = 70}, {ore = "cassiterite", low_grade = "cassiterite_low_grade", percent = 10}, {ore = "sand", percent = 20}]
	}
	{
		id = "coal"
		name_key = "vein_type_coal"
		weight = 25
		biomes = ["plains", "hills", "steppe", "wetland"]
		outcrop_blocks = ["coal_ore"]
		outputs = [{ore = "coal", percent = 90}, {ore = "gravel", percent = 10}]
	}
	{
		id = "mixed"
		name_key = "vein_type_mixed"
		weight = 10
		biomes = ["hills"]
		outcrop_blocks = ["hematite_ore", "chalcopyrite_ore"]
		outputs = [{ore = "hematite", low_grade = "hematite_low_grade", percent = 40}, {ore = "chalcopyrite", low_grade = "chalcopyrite_low_grade", percent = 40}, {ore = "gravel", percent = 20}]
	}
	{
		id = "quarry"
		name_key = "vein_type_quarry"
		weight = 10
		biomes = []
		outcrop_blocks = ["stone"]
		outputs = [{ore = "stone", percent = 60}, {ore = "sand", percent = 20}, {ore = "gravel", percent = 20}]
	}
	{
		id = "lead"
		name_key = "vein_type_lead"
		weight = 8
		biomes = ["hills", "forest", "highland"]
		outcrop_blocks = ["galena_ore"]
		outputs = [{ore = "galena", low_grade = "galena_low_grade", percent = 70}, {ore = "sphalerite", low_grade = "sphalerite_low_grade", percent = 10}, {ore = "gravel", percent = 20}]
	}
	{
		id = "zinc"
		name_key = "vein_type_zinc"
		weight = 8
		biomes = ["hills", "desert", "badlands"]
		outcrop_blocks = ["sphalerite_ore"]
		outputs = [{ore = "sphalerite", low_grade = "sphalerite_low_grade", percent = 70}, {ore = "galena", low_grade = "galena_low_grade", percent = 10}, {ore = "gravel", percent = 20}]
	}
	{
		id = "nickel"
		name_key = "vein_type_nickel"
		weight = 6
		biomes = ["desert", "plains", "badlands", "cold_barrens", "coastal_dunes"]
		outcrop_blocks = ["pentlandite_ore"]
		outputs = [{ore = "pentlandite", low_grade = "pentlandite_low_grade", percent = 60}, {ore = "chalcopyrite", low_grade = "chalcopyrite_low_grade", percent = 20}, {ore = "sand", percent = 20}]
	}
	{
		id = "deep_iron"
		name_key = "vein_type_deep_iron"
		deep = true
		weight = 25
		biomes = []
		outcrop_blocks = []
		outputs = [{ore = "hematite", low_grade = "hematite_low_grade", percent = 90}, {ore = "gravel", percent = 10}]
	}
	{
		id = "deep_copper"
		name_key = "vein_type_deep_copper"
		deep = true
		weight = 20
		biomes = []
		outcrop_blocks = []
		outputs = [{ore = "chalcopyrite", low_grade = "chalcopyrite_low_grade", percent = 75}, {ore = "cassiterite", low_grade = "cassiterite_low_grade", percent = 15}, {ore = "sand", percent = 10}]
	}
	{
		id = "bauxite"
		name_key = "vein_type_bauxite"
