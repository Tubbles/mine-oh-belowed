		biomes = []
		outcrop_blocks = []
		outputs = [{ore = "bauxite", low_grade = "bauxite_low_grade", percent = 85}, {ore = "gravel", percent = 15}]
	}
	{
		id = "gold_quartz"
		name_key = "vein_type_gold_quartz"
