// Benchmark module (work item 0050): an iron smelting line on its own
// iron vein, coal vein and power; assembly.sjson smelts copper.
// Coordinates are relative to the module's minimum corner on the
// surface (y 0), see doc/commands.md; the manifest (../benchmark.sjson)
// adds the veins.
//
// North (z 0 to 7): an electric drill on the coal vein drops onto a
// coal belt running west into a sink chest. Inserters take coal from it
// into two steel furnaces and a combustion generator. Fast inserters
// empty the furnaces (plates and slag) into chests. South (z 8 to 13):
// two electric drills on the ore vein drop onto an ore belt running
// east into a splitter filtered to hematite; everything else (gravel,
// low grade ore) leaves by the other half, up a belt lift and into a
// sink chest on stone, since a furnace holding one low grade ore waits
// for a second and would stop the line. The hematite goes on into a
// second splitter whose halves feed one furnace each: an inserter from
// the near half, a long inserter reaching over it from the far half.
// Each drill, inserter and the generator has a cable to a junction
// cabinet, and the cabinets are cabled towards the generator (work item
// 0368). The generator and the furnaces get starting coal.
origin = [0, 0, 0]
commands = [
	// Coal: drill, belt west, sink
	"place electric_mining_drill 17 0 0 1"
	"place belt 18 0 3 2"
	"place belt 17 0 3 2"
	"place belt 16 0 3 2"
	"place belt 15 0 3 2"
	"place belt 14 0 3 2"
	"place belt 13 0 3 2"
	"place belt 12 0 3 2"
	"place belt 11 0 3 2"
	"place belt 10 0 3 2"
	"place belt 9 0 3 2"
	"place belt 8 0 3 2"
	"place belt 7 0 3 2"
	"place belt 6 0 3 2"
	"place belt 5 0 3 2"
	"place belt 4 0 3 2"
	"place belt 3 0 3 2"
	"place belt 2 0 3 2"
	"place inserter 1 0 3 2"
	"place iron_chest 0 0 3 0"
	// Generator and furnaces with their fuel and output inserters
	"place combustion_generator 3 0 5 0"
	"place inserter 4 0 4 1"
	"place steel_furnace 12 0 5 0"
	"place inserter 12 0 4 1"
	"place fast_inserter 14 0 5 0"
	"place iron_chest 15 0 5 0"
	"place steel_furnace 16 0 5 0"
	"place inserter 16 0 4 1"
	"place fast_inserter 18 0 5 0"
	"place iron_chest 19 0 5 0"
	"place inserter 12 0 7 3"
	"place long_inserter 16 0 7 3"
	// Ore: drills, belt east, the filter splitter sorting the ore left
	"place electric_mining_drill 1 0 11 3"
	"place electric_mining_drill 4 0 11 3"
	"place belt 1 0 10 0"
	"place belt 2 0 10 0"
	"place belt 3 0 10 0"
	"place belt 4 0 10 0"
	"place belt 5 0 10 0"
	"place splitter 6 0 9 0"
	"filter hematite 6 0 9"
	// The rest up a belt lift into a sink chest on stone
	"place belt 7 0 10 0"
	"place belt 8 0 10 0"
	"place belt_lift 9 0 10 0"
	"block stone 10 0 10"
	"block stone 11 0 10"
	"block stone 12 0 10"
	"place belt 10 1 10 0"
	"place inserter 11 1 10 0"
	"place iron_chest 12 1 10 0"
	// The ore into a splitter feeding one furnace per half
	"place belt 7 0 9 0"
	"place splitter 8 0 8 0"
	"place belt 9 0 8 0"
	"place belt 10 0 8 0"
	"place belt 11 0 8 0"
	"place belt 12 0 8 0"
	"place belt 13 0 8 0"
	"place belt 9 0 9 0"
	"place belt 10 0 9 0"
	"place belt 11 0 9 0"
	"place belt 12 0 9 0"
	"place belt 13 0 9 0"
	"place belt 14 0 9 0"
	"place belt 15 0 9 0"
	"place belt 16 0 9 0"
	"place belt 17 0 9 0"
	// Junction cabinets
	"place junction_cabinet 1 0 4 0"
	"place junction_cabinet 6 0 4 0"
	"place junction_cabinet 10 0 4 0"
	"place junction_cabinet 14 0 4 0"
	"place junction_cabinet 18 0 4 0"
	"place junction_cabinet 10 0 7 0"
	"place junction_cabinet 14 0 7 0"
	"place junction_cabinet 0 0 10 0"
	"place junction_cabinet 7 0 12 0"
	"place junction_cabinet 12 0 12 0"
	// The cables: each machine to a cabinet, the cabinets towards the generators
	"cable heavy_cable 1 0 4 b 6 0 4 a"
	"cable heavy_cable 6 0 4 b 10 0 4 a"
	"cable light_cable 10 0 4 d 10 0 7 c"
	"cable light_cable 10 0 4 b 14 0 4 a"
	"cable light_cable 14 0 4 d 14 0 7 c"
	"cable light_cable 14 0 4 b 18 0 4 a"
	"cable light_cable 10 0 7 d 12 0 12 c"
	"cable light_cable 12 0 12 a 7 0 12 b"
	"cable light_cable 1 0 4 d 0 0 10 c"
	"cable light_cable 1 0 3 power 1 0 4 c"
	"cable heavy_cable 3 0 5 power 1 0 4 h"
	"cable light_cable 4 0 4 power 6 0 4 e"
	"cable light_cable 12 0 4 power 14 0 4 e"
	"cable light_cable 14 0 5 power 14 0 4 c"
	"cable light_cable 17 0 0 power 18 0 4 c"
	"cable light_cable 16 0 4 power 18 0 4 e"
	"cable light_cable 18 0 5 power 18 0 4 d"
	"cable light_cable 12 0 7 power 10 0 7 b"
	"cable light_cable 11 1 10 power 10 0 7 h"
	"cable light_cable 16 0 7 power 14 0 7 b"
	"cable light_cable 1 0 11 power 0 0 10 d"
	"cable light_cable 4 0 11 power 7 0 12 a"
	// Starting coal
	"insert coal 45 3 0 5"
	"insert coal 45 12 0 5"
	"insert coal 45 16 0 5"
]
