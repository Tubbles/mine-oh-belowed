	"cable light_cable 22 0 7 b 26 0 7 a"
	"cable light_cable 10 0 7 d 11 0 11 c"
	"cable heavy_cable 19 0 4 b 23 0 2 a"
	"cable light_cable 23 0 2 b 27 0 2 a"
	"cable light_cable 2 0 0 power 5 0 1 c"
	"cable light_cable 6 0 0 power 5 0 1 b"
	"cable light_cable 17 0 0 power 19 0 4 c"
	"cable heavy_cable 20 0 0 power 19 0 4 g"
	"cable light_cable 21 0 2 power 19 0 4 f"
	"cable light_cable 20 0 4 power 19 0 4 h"
