	"place belt 7 0 8 2"
	"place belt 6 0 8 2"
	"place belt 5 0 8 2"
	"place belt 4 0 8 2"
	"place belt 3 0 8 2"
	"place belt 2 0 8 2"
	"place fast_inserter 1 0 8 2"
	"place iron_chest 0 0 8 0"
	"place belt 24 0 9 2"
	"place belt 23 0 9 2"
	"place belt 22 0 9 2"
	"place belt 21 0 9 2"
