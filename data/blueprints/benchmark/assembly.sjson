	"place junction_cabinet 11 0 11 0"
	// The cables: each machine to a cabinet, the cabinets towards the generators
	"cable light_cable 5 0 1 d 5 0 7 c"
	"cable light_cable 5 0 7 d 5 0 10 c"
	"cable light_cable 5 0 7 a 1 0 7 b"
	"cable heavy_cable 5 0 7 b 10 0 7 a"
	"cable heavy_cable 10 0 7 b 14 0 7 a"
	"cable heavy_cable 14 0 7 b 18 0 7 a"
	"cable heavy_cable 18 0 7 c 19 0 4 d"
