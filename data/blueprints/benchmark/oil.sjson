// Benchmark module (work item 0050): oil processing on its own tar
// pits, water, coal vein and power. Coordinates are relative to the
// module's minimum corner on the surface (y 0), see doc/commands.md;
// the manifest (../benchmark.sjson) adds the vein.
//
// Two tar pit pumps on tar pits laid into the grass pipe crude oil into
// a refinery. Its petroleum gas feeds a chemical plant making plastic
// bars from coal into a chest. Its heavy oil goes into a cracking unit,
// whose light oil joins the refinery's in a second cracking unit; each
// cracking unit has an offshore pump on its own pool of water. The
// second one's petroleum gas is the waste and goes into a flare stack,
// its only taker on that netlist. (A flare is a relief valve: it takes
// only the gas nothing else on its netlist asks for or keeps, and burns
// it above 90 percent of its port.) Two electric drills on the coal
// vein drop onto a coal belt that feeds the plant and three combustion
// generators and ends in a sink chest. Every electric machine, the
// offshore pumps too (work item 0140), has a cable to a junction
// cabinet, heavy from the generators and the refinery, and the cabinets
// are cabled towards the generators (work item 0368); the generators get
// starting coal.
origin = [0, 0, 0]
commands = [
	// Two tar pit pumps pipe crude oil into the refinery
	"block tar_pit 15 -1 2"
	"block tar_pit 15 -1 4"
	"place tar_pit_pump 13 0 2 0"
	"place tar_pit_pump 13 0 4 0"
	"place pipe 12 0 2 0"
	"place pipe 12 0 3 0"
	"place pipe 12 0 4 0"
	"place pipe 12 0 5 0"
	"place refinery 10 0 6 0"
	// Its petroleum gas into a chemical plant making plastic bars into a chest
	"place pipe 9 0 8 0"
	"place chemical_plant 6 0 7 1"
	"place inserter 5 0 8 0"
	"place inserter 7 0 10 1"
	"place iron_chest 7 0 11 0"
	// Heavy oil round to a cracking unit with its own water
	"place pipe 15 0 8 0"
	"place pipe 15 0 7 0"
	"place pipe 16 0 7 0"
	"place pipe 17 0 7 0"
	"place pipe 18 0 7 0"
	"place pipe 19 0 7 0"
	"place pipe 20 0 7 0"
	"place pipe 20 0 8 0"
	"place pipe 20 0 9 0"
	"place pipe 20 0 10 0"
	"place pipe 20 0 11 0"
	"place pipe 19 0 11 0"
	"place pipe 18 0 11 0"
	"place cracking_unit 15 0 10 1"
	"block water 19 -1 9"
	"place offshore_pump 17 0 9 0"
	"place pipe 16 0 9 0"
	// Light oil (the refinery's and the cracked) into a second cracking unit
	"place pipe 12 0 11 0"
	"place pipe 13 0 11 0"
	"place pipe 14 0 11 0"
	"place cracking_unit 11 0 12 0"
	"block water 6 -1 13"
	"block water 7 -1 13"
	"place offshore_pump 8 0 13 2"
	"place pipe 10 0 13 0"
	// Its petroleum gas, the waste, into a flare stack
	"place flare_stack 12 0 15 0"
	// Coal: two drills, a belt south past the plant and three generators, a sink
	"place electric_mining_drill 1 0 1 0"
	"place electric_mining_drill 5 0 3 2"
	"place belt 4 0 2 1"
	"place belt 4 0 3 1"
	"place belt 4 0 4 1"
	"place belt 4 0 5 1"
	"place belt 4 0 6 1"
	"place belt 4 0 7 1"
	"place belt 4 0 8 1"
	"place belt 4 0 9 1"
	"place belt 4 0 10 1"
	"place belt 4 0 11 1"
	"place belt 4 0 12 1"
	"place belt 4 0 13 1"
	"place belt 4 0 14 1"
	"place belt 4 0 15 1"
	"place combustion_generator 0 0 7 0"
	"place inserter 3 0 7 2"
	"place combustion_generator 0 0 10 0"
	"place inserter 3 0 10 2"
	"place combustion_generator 0 0 13 0"
	"place inserter 3 0 13 2"
	"place inserter 4 0 16 1"
	"place iron_chest 4 0 17 0"
	// Junction cabinets
	"place junction_cabinet 11 0 4 0"
	"place junction_cabinet 18 0 13 0"
	"place junction_cabinet 9 0 6 0"
	"place junction_cabinet 5 0 1 0"
	"place junction_cabinet 5 0 6 0"
	"place junction_cabinet 5 0 11 0"
	"place junction_cabinet 5 0 15 0"
	"place junction_cabinet 10 0 11 0"
	"place junction_cabinet 14 0 15 0"
	"place junction_cabinet 1 0 9 0"
	"place junction_cabinet 1 0 12 0"
	"place junction_cabinet 18 0 8 0"
	// The cables: each machine to a cabinet, the cabinets towards the generators
	"cable light_cable 11 0 4 a 9 0 6 c"
	"cable heavy_cable 9 0 6 a 5 0 6 b"
	"cable light_cable 5 0 6 c 5 0 1 d"
	"cable heavy_cable 5 0 6 d 5 0 11 c"
	"cable light_cable 5 0 11 d 5 0 15 c"
	"cable heavy_cable 5 0 11 a 1 0 12 b"
	"cable heavy_cable 1 0 12 c 1 0 9 d"
	"cable heavy_cable 5 0 11 b 10 0 11 a"
	"cable light_cable 10 0 11 b 14 0 15 c"
	"cable light_cable 14 0 15 b 18 0 13 a"
	"cable light_cable 18 0 13 c 18 0 8 d"
	"cable light_cable 13 0 2 power 11 0 4 b"
	"cable light_cable 13 0 4 power 11 0 4 f"
	"cable light_cable 5 0 3 power 9 0 6 e"
	"cable heavy_cable 10 0 6 power 9 0 6 b"
	"cable light_cable 6 0 7 power 9 0 6 d"
	"cable light_cable 1 0 1 power 5 0 1 a"
	"cable light_cable 3 0 7 power 5 0 6 a"
	"cable light_cable 5 0 8 power 5 0 6 h"
	"cable light_cable 3 0 10 power 5 0 11 e"
	"cable light_cable 7 0 10 power 5 0 11 f"
	"cable light_cable 3 0 13 power 5 0 15 a"
	"cable light_cable 4 0 16 power 5 0 15 d"
	"cable light_cable 11 0 12 power 10 0 11 d"
	"cable light_cable 8 0 13 power 10 0 11 e"
	"cable light_cable 12 0 15 power 14 0 15 a"
	"cable heavy_cable 0 0 7 power 1 0 9 a"
	"cable heavy_cable 0 0 10 power 1 0 12 a"
	"cable heavy_cable 0 0 13 power 1 0 12 d"
	"cable light_cable 17 0 9 power 18 0 8 h"
	"cable light_cable 15 0 10 power 18 0 8 a"
	// Starting coal for the generators
	"insert coal 45 0 0 7"
	"insert coal 45 0 0 10"
	"insert coal 45 0 0 13"
]
