// The terrain field's materials (work item 0171, doc/content.md, Field
// materials): one entry per material of the field but air, every key
// required. item is what a cubic metre of the material dug by hand yields
// and placing it takes (items.sjson); an empty item marks a material that
// cannot be dug or placed. tool_tier is the pickaxe the hand tool needs,
// as blocks.sjson's tool_tier: 0 hands, 1 wooden, 2 stone, 3 iron.
// dig_rate_percent (10 to 400) scales the brush's rate on the material
// (work item 0179): soft ground digs faster, deep stone slower.
// The ores are the outcrops of the veins on the sphere (work item 0179,
// doc/content.md, Veins on the sphere): coal with the wooden pickaxe,
// hematite and chalcopyrite with the stone one, all a little slower than
// stone.
// The textures are in textures/field_materials.sjson.
materials = [
	{id = "topsoil", item = "dirt", tool_tier = 0, dig_rate_percent = 150}
	{id = "stone", item = "stone", tool_tier = 1, dig_rate_percent = 100}
	{id = "deep_stone", item = "deep_stone", tool_tier = 3, dig_rate_percent = 60}
	{id = "bedrock", item = "", tool_tier = 0, dig_rate_percent = 100}
	{id = "hematite_ore", item = "hematite", tool_tier = 2, dig_rate_percent = 80}
	{id = "chalcopyrite_ore", item = "chalcopyrite", tool_tier = 2, dig_rate_percent = 80}
	{id = "coal_ore", item = "coal", tool_tier = 1, dig_rate_percent = 80}
]
