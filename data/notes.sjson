	{id = "tar_flats", title_key = "note_tar_flats_title", text_key = "note_tar_flats_text", unlock = {chapter = 6}}
	{id = "the_flare", title_key = "note_the_flare_title", text_key = "note_the_flare_text", unlock = {quest = "flare"}}
	{id = "deep_strata", title_key = "note_deep_strata_title", text_key = "note_deep_strata_text", unlock = {technology = "deep_mining"}}
