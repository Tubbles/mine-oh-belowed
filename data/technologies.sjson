// Technologies (work items 0012 and 0021) from doc/content.md, science
// pack 1 tier. Labs research them one at a time (lab.odin); the research
// recipes stay locked until then unless every recipe is unlocked
// (--unlock-all or the all_recipes_unlocked setting in game.sjson).
// name_key is a key into data/strings/en.sjson.
// unlocks lists recipe ids from recipes.sjson. Each of those recipes must
// have channel research and name this technology, and every research
// recipe must be listed by its technology. The list may be empty only
// with placeholder = true.
// packs is the number of units, seconds the time per unit in a speed 1
// lab. science_packs lists the items a unit consumes, one of each; the lab
// has one slot per distinct item any technology names, in order of first
// appearance.
// prerequisites lists technology ids that must be researched first; each
// must be listed earlier in this file, which also rules out cycles.
// logistics_science and fast_belts unlock phase 5 recipes that do not
// exist yet, so they are placeholders with empty lists. ore_processing
// (work item 0026) unlocks the crusher and washer and the crushing and
// washing recipes; the alloy furnace is a start recipe since 0027, so
// bronze is reachable in phase 2. recycling (work item 0027) unlocks the
// recycler. 15 s per pack is a guess for both. oil_processing (work item
// 0029) is the phase 6 gate: chapter 5's main quest grants it through the
// quest channel, and with quest_gate = true the labs refuse it, so it
// waits for its main quest and nothing else; its cost only shows in the
// technology screen. Since work item 0030 it unlocks the tar pit pump,
// the refinery, the flare stack and refining. cracking (work item 0030,
// science pack 1 until later packs exist) unlocks the cracking unit and
// both cracking recipes; 30 s per pack is a guess.
// placeholder = true marks a technology that unlocks nothing yet, and
// quest_gate = true one only a main quest reward researches; labs refuse
// both.
technologies = [
	{id = "automation", name_key = "technology_automation", unlocks = ["assembler_1"], packs = 10, seconds = 10, science_packs = ["science_pack_1"]}
	{id = "logistics", name_key = "technology_logistics", unlocks = ["splitter", "filter_inserter"], packs = 20, seconds = 15, science_packs = ["science_pack_1"], prerequisites = ["automation"]}
	{id = "electric_mining", name_key = "technology_electric_mining", unlocks = ["electric_mining_drill", "power_switch"], packs = 25, seconds = 15, science_packs = ["science_pack_1"], prerequisites = ["automation"]}
	{id = "optics", name_key = "technology_optics", unlocks = ["lamp"], packs = 10, seconds = 15, science_packs = ["science_pack_1"], prerequisites = ["electric_mining"]}
	{id = "steel_processing", name_key = "technology_steel_processing", unlocks = ["steel", "steel_furnace"], packs = 50, seconds = 15, science_packs = ["science_pack_1"], prerequisites = ["automation"]}
	{id = "fluid_handling", name_key = "technology_fluid_handling", unlocks = ["pump", "storage_tank"], packs = 50, seconds = 15, science_packs = ["science_pack_1"], prerequisites = ["steel_processing"]}
	{id = "prospecting", name_key = "technology_prospecting", unlocks = ["core_sample_drill", "magnetometer"], packs = 50, seconds = 15, science_packs = ["science_pack_1"], prerequisites = ["steel_processing"]}
	{id = "ore_processing", name_key = "technology_ore_processing", unlocks = ["crusher", "washer", "crush_hematite", "crush_chalcopyrite", "crush_cassiterite", "crush_galena", "crush_sphalerite", "crush_pentlandite", "wash_hematite", "wash_chalcopyrite", "wash_cassiterite", "wash_galena", "wash_sphalerite", "wash_pentlandite"], packs = 50, seconds = 15, science_packs = ["science_pack_1"], prerequisites = ["steel_processing"]}
	{id = "recycling", name_key = "technology_recycling", unlocks = ["recycler"], packs = 50, seconds = 15, science_packs = ["science_pack_1"], prerequisites = ["ore_processing"]}
	{id = "logistics_science", name_key = "technology_logistics_science", unlocks = [], packs = 75, seconds = 15, science_packs = ["science_pack_1"], prerequisites = ["logistics"], placeholder = true}
	{id = "fast_belts", name_key = "technology_fast_belts", unlocks = [], packs = 100, seconds = 30, science_packs = ["science_pack_1"], prerequisites = ["logistics_science"], placeholder = true}
	{id = "oil_processing", name_key = "technology_oil_processing", unlocks = ["tar_pit_pump", "refinery", "flare_stack", "refining"], packs = 100, seconds = 30, science_packs = ["science_pack_1"], prerequisites = ["ore_processing"], quest_gate = true}
	{id = "cracking", name_key = "technology_cracking", unlocks = ["cracking_unit", "heavy_oil_cracking", "light_oil_cracking"], packs = 75, seconds = 30, science_packs = ["science_pack_1"], prerequisites = ["oil_processing"]}
]
