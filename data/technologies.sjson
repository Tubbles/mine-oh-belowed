// Technologies (work items 0012 and 0021) from doc/content.md, science
// pack 1 tier. Labs research them one at a time (lab.odin); the research
// recipes stay locked until then unless every recipe is unlocked
// (--unlock-all or the all_recipes_unlocked setting in game.sjson).
// name_key is a key into data/strings/en.sjson.
// unlocks lists recipe ids from recipes.sjson. Each of those recipes must
// have channel research and name this technology, and every research
// recipe must be listed by its technology. The list may be empty only
// with placeholder = true.
// packs is the number of units, seconds the time per unit in a speed 1
// lab. science_packs lists the items a unit consumes, one of each; the lab
// has one slot per distinct item any technology names, in order of first
// appearance.
// prerequisites lists technology ids that must be researched first; each
// must be listed earlier in this file, which also rules out cycles.
// fast_belts (work item 0037) unlocks belt 2 with its ramp and lift.
// hydro_power, electric_grid and fast_inserters (work item 0037, science
// packs 1 and 2) unlock the hydro turbine, the big pole and substation,
// and the fast and long inserters; the seconds of the last two are
// guesses. ore_processing
// (work item 0026) unlocks the crusher and washer and the crushing and
// washing recipes; the alloy furnace is a start recipe since 0027, so
// bronze is reachable in phase 2. recycling (work item 0027) unlocks the
// recycler. 15 s per pack is a guess for both. oil_processing (work item
// 0029) is the phase 6 gate: chapter 5's main quest grants it through the
// quest channel, and with quest_gate = true the labs refuse it, so it
// waits for its main quest and nothing else; its cost only shows in the
// technology screen. Since work item 0030 it unlocks the tar pit pump,
// the refinery, the flare stack and refining. cracking (work item 0030,
// science pack 1 until later packs exist) unlocks the cracking unit and
// both cracking recipes; 30 s per pack is a guess.
// plastics, renewable_plastics and bitumen_paving (work item 0031, science
// pack 1) unlock the two plastic routes and the bitumen and asphalt
// recipes. logistics_science unlocks science pack 2 since 0031 and needs
// plastics since 0032, since the pack is made from plastic; fast belts
// cost science packs 1 and 2. combustion_power (work item 0032, science pack 1) unlocks the
// combustion generator; 30 s per pack is a guess.
// deep_mining (work item 0033) is the phase 7 gate: chapter 6's main
// quest grants it through the quest channel, and as a quest_gate the labs
// refuse it; its cost only shows in the technology screen. Since work
// item 0035 it unlocks the bore drill, the mining fluid and the bauxite
// crushing and washing (the revival ports come with the drills).
// electrolysis (work item 0035, science packs 1 and 2) unlocks the
// electrolyser, alumina, aluminium plate and silicon; 30 s per pack is a
// guess.
// seismic_survey (work item 0038, science packs 1 and 2) unlocks the
// thumper charge; 30 s per pack is a guess.
// rocket_program (work item 0039) is the phase 8 gate: chapter 7's main
// quest grants it through the quest channel; its cost and prerequisite
// are guesses. Since work item 0040 it unlocks the launch pad, the rocket
// structure and the guidance unit. rocketry (work item 0040, science
// packs 1 and 2) unlocks rocket fuel and the cargo capsule.
// placeholder = true marks a technology that unlocks nothing yet, and
// quest_gate = true one only a main quest reward researches; labs refuse
// both.
technologies = [
	{id = "automation", name_key = "technology_automation", unlocks = ["assembler_1"], packs = 10, seconds = 10, science_packs = ["science_pack_1"]}
	{id = "logistics", name_key = "technology_logistics", unlocks = ["splitter", "filter_inserter"], packs = 20, seconds = 15, science_packs = ["science_pack_1"], prerequisites = ["automation"]}
	{id = "electric_mining", name_key = "technology_electric_mining", unlocks = ["electric_mining_drill", "power_switch"], packs = 25, seconds = 15, science_packs = ["science_pack_1"], prerequisites = ["automation"]}
	{id = "optics", name_key = "technology_optics", unlocks = ["lamp"], packs = 10, seconds = 15, science_packs = ["science_pack_1"], prerequisites = ["electric_mining"]}
	{id = "steel_processing", name_key = "technology_steel_processing", unlocks = ["steel", "steel_furnace"], packs = 50, seconds = 15, science_packs = ["science_pack_1"], prerequisites = ["automation"]}
	{id = "fluid_handling", name_key = "technology_fluid_handling", unlocks = ["pump", "storage_tank"], packs = 50, seconds = 15, science_packs = ["science_pack_1"], prerequisites = ["steel_processing"]}
	{id = "prospecting", name_key = "technology_prospecting", unlocks = ["core_sample_drill", "magnetometer"], packs = 50, seconds = 15, science_packs = ["science_pack_1"], prerequisites = ["steel_processing"]}
	{id = "ore_processing", name_key = "technology_ore_processing", unlocks = ["crusher", "washer", "crush_hematite", "crush_chalcopyrite", "crush_cassiterite", "crush_galena", "crush_sphalerite", "crush_pentlandite", "wash_hematite", "wash_chalcopyrite", "wash_cassiterite", "wash_galena", "wash_sphalerite", "wash_pentlandite"], packs = 50, seconds = 15, science_packs = ["science_pack_1"], prerequisites = ["steel_processing"]}
	{id = "recycling", name_key = "technology_recycling", unlocks = ["recycler"], packs = 50, seconds = 15, science_packs = ["science_pack_1"], prerequisites = ["ore_processing"]}
	{id = "oil_processing", name_key = "technology_oil_processing", unlocks = ["tar_pit_pump", "refinery", "flare_stack", "refining"], packs = 100, seconds = 30, science_packs = ["science_pack_1"], prerequisites = ["ore_processing"], quest_gate = true}
	{id = "cracking", name_key = "technology_cracking", unlocks = ["cracking_unit", "heavy_oil_cracking", "light_oil_cracking"], packs = 75, seconds = 30, science_packs = ["science_pack_1"], prerequisites = ["oil_processing"]}
	{id = "plastics", name_key = "technology_plastics", unlocks = ["chemical_plant", "plastic_bar", "sulfur"], packs = 100, seconds = 30, science_packs = ["science_pack_1"], prerequisites = ["oil_processing"]}
	{id = "logistics_science", name_key = "technology_logistics_science", unlocks = ["science_pack_2"], packs = 75, seconds = 15, science_packs = ["science_pack_1"], prerequisites = ["logistics", "plastics"]}
	{id = "fast_belts", name_key = "technology_fast_belts", unlocks = ["belt_2", "belt_ramp_2", "belt_lift_2"], packs = 100, seconds = 30, science_packs = ["science_pack_1", "science_pack_2"], prerequisites = ["logistics_science"]}
	{id = "hydro_power", name_key = "technology_hydro_power", unlocks = ["hydro_turbine"], packs = 100, seconds = 30, science_packs = ["science_pack_1", "science_pack_2"], prerequisites = ["fluid_handling"]}
	{id = "electric_grid", name_key = "technology_electric_grid", unlocks = ["big_pole", "substation"], packs = 100, seconds = 30, science_packs = ["science_pack_1", "science_pack_2"], prerequisites = ["electric_mining"]}
	{id = "fast_inserters", name_key = "technology_fast_inserters", unlocks = ["fast_inserter", "long_inserter"], packs = 75, seconds = 30, science_packs = ["science_pack_1", "science_pack_2"], prerequisites = ["logistics"]}
	{id = "renewable_plastics", name_key = "technology_renewable_plastics", unlocks = ["wood_gasifier", "wood_gasification", "syngas_plastic"], packs = 75, seconds = 30, science_packs = ["science_pack_1"], prerequisites = ["plastics"]}
	{id = "bitumen_paving", name_key = "technology_bitumen_paving", unlocks = ["bitumen", "asphalt"], packs = 50, seconds = 30, science_packs = ["science_pack_1"], prerequisites = ["plastics"]}
	{id = "combustion_power", name_key = "technology_combustion_power", unlocks = ["combustion_generator"], packs = 75, seconds = 30, science_packs = ["science_pack_1"], prerequisites = ["oil_processing"]}
	{id = "deep_mining", name_key = "technology_deep_mining", unlocks = ["bore_drill", "mining_fluid", "crush_bauxite", "wash_bauxite"], packs = 200, seconds = 30, science_packs = ["science_pack_1", "science_pack_2"], prerequisites = ["plastics"], quest_gate = true}
	{id = "seismic_survey", name_key = "technology_seismic_survey", unlocks = ["thumper_charge"], packs = 100, seconds = 30, science_packs = ["science_pack_1", "science_pack_2"], prerequisites = ["prospecting"]}
	{id = "electrolysis", name_key = "technology_electrolysis", unlocks = ["electrolyser", "alumina", "aluminium_plate", "silicon"], packs = 150, seconds = 30, science_packs = ["science_pack_1", "science_pack_2"], prerequisites = ["deep_mining"]}
	{id = "rocket_program", name_key = "technology_rocket_program", unlocks = ["launch_pad", "rocket_structure", "guidance_unit"], packs = 300, seconds = 30, science_packs = ["science_pack_1", "science_pack_2"], prerequisites = ["electrolysis"], quest_gate = true}
	{id = "rocketry", name_key = "technology_rocketry", unlocks = ["rocket_fuel", "cargo_capsule"], packs = 200, seconds = 30, science_packs = ["science_pack_1", "science_pack_2"], prerequisites = ["rocket_program"]}
]
