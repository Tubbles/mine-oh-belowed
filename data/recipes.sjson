// Recipes (work item 0012): every recipe of doc/content.md phases 1 to 4,
// loaded after items.sjson and resolved to a dense recipe index.
// id is unique. name_key (optional) is a key into data/strings/en.sjson;
// without it the recipe is named after its first output item.
// inputs and outputs are lists of {item, count}. Byproducts are ordinary
// outputs flagged byproduct = true (work item 0027): with the lenient
// byproducts world setting a byproduct that does not fit its output slot
// is voided and the craft completes; strict (the default) waits for room
// like any output. A recipe needs at least one output that is not a
// byproduct. fluid_inputs (work item 0026, optional) lists {fluid, litres}
// a crafting machine takes from its input ports when a craft starts, which
// waits until every one is fully there (work item 0031); fluids are never
// items. fluid_outputs (work item 0030, optional) lists
// {fluid, litres, byproduct} delivered into the machine's output ports
// when the craft completes, the first into the first output port; a
// flagged fluid byproduct follows the item rule. A recipe needs at least
// one input and one output, items or fluids; one without an item output
// needs a name_key.
// seconds is the time at speed 1 (a hand crafts at speed 1).
// made_in lists what can make the recipe: hand, furnace, or a crafting
// machine category (assembler, crusher, washer, alloy_furnace, refinery,
// cracking, chemistry, gasifier, electrolysis; see machines.sjson). Furnace recipes must have one input, one main output
// and at most one byproduct output (the slag slot), and two of them may
// not share an input item; two input alloys are made in the alloy
// furnace. Hand and furnace recipes take no fluid_inputs. No recipe is
// made in the recycler: it reverses the first recipe that makes its input
// (work item 0027).
// Ore processing (work item 0026): the crusher turns 2 low grade ore into
// 2 crushed ore and 1 gravel, the washer 1 crushed ore and 30 L of water
// into 1 ore and 1 mud, so processing recovers the ore. Smelting ore and
// every alloy gives 1 slag per craft (work item 0027). The times and the
// alloy furnace recipes are guesses pending the couch tests.
// category is the recipe browser tab: materials, components, tools,
// machines, logistics, power, science.
// tags are free words for the browser's tag filter, each with a string
// recipe_tag_<tag>.
// channel is how the recipe becomes available: start (always), discovery
// (once every input item has been obtained), research (once technology,
// an id from technologies.sjson, is researched) or quest (a main quest
// gate, work item 0013; locked until then) or schematic (an alternate
// recipe found in caves, work item 0036: locked until the usable item
// named by schematic, an id from items.sjson, is read). Machines make a
// schematic recipe only once it is found, since its inputs are common.
// Machine recipes take 2 s, inserters, belts, pipes, poles and chests
// 0.5 s (doc/content.md). Tools take 1 s.
recipes = [
	// Materials
	{id = "plank", inputs = [{item = "log", count = 1}], outputs = [{item = "plank", count = 4}], seconds = 0.5, made_in = ["hand", "assembler"], category = "materials", tags = ["wood"], channel = "start"}
	{id = "stick", inputs = [{item = "plank", count = 1}], outputs = [{item = "stick", count = 4}], seconds = 0.5, made_in = ["hand", "assembler"], category = "materials", tags = ["wood"], channel = "start"}
	// Slabs and stairs (work item 0061): 1 block gives 2 slabs, 3 give 4 stairs.
	{id = "stone_slab", inputs = [{item = "stone", count = 1}], outputs = [{item = "stone_slab", count = 2}], seconds = 0.5, made_in = ["hand", "assembler"], category = "materials", tags = ["stone", "building"], channel = "start"}
	{id = "stone_stairs", inputs = [{item = "stone", count = 3}], outputs = [{item = "stone_stairs", count = 4}], seconds = 0.5, made_in = ["hand", "assembler"], category = "materials", tags = ["stone", "building"], channel = "start"}
	{id = "concrete_slab", inputs = [{item = "concrete", count = 1}], outputs = [{item = "concrete_slab", count = 2}], seconds = 0.5, made_in = ["hand", "assembler"], category = "materials", tags = ["building"], channel = "start"}
	{id = "concrete_stairs", inputs = [{item = "concrete", count = 3}], outputs = [{item = "concrete_stairs", count = 4}], seconds = 0.5, made_in = ["hand", "assembler"], category = "materials", tags = ["building"], channel = "start"}
	{id = "plank_slab", inputs = [{item = "plank", count = 1}], outputs = [{item = "plank_slab", count = 2}], seconds = 0.5, made_in = ["hand", "assembler"], category = "materials", tags = ["wood", "building"], channel = "start"}
	{id = "plank_stairs", inputs = [{item = "plank", count = 3}], outputs = [{item = "plank_stairs", count = 4}], seconds = 0.5, made_in = ["hand", "assembler"], category = "materials", tags = ["wood", "building"], channel = "start"}
	{id = "stone_brick", inputs = [{item = "stone", count = 2}], outputs = [{item = "stone_brick", count = 1}], seconds = 3.2, made_in = ["furnace"], category = "materials", tags = ["smelting", "stone"], channel = "start"}
	{id = "charcoal", inputs = [{item = "log", count = 2}], outputs = [{item = "charcoal", count = 1}], seconds = 3.2, made_in = ["furnace"], category = "materials", tags = ["smelting", "wood", "fuel"], channel = "discovery"}
