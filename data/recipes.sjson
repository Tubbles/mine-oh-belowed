// Recipes (work item 0012): every recipe of doc/content.md phases 1 to 4,
// loaded after items.sjson and resolved to a dense recipe index.
// id is unique. name_key (optional) is a key into data/strings/en.sjson;
// without it the recipe is named after its first output item.
// inputs and outputs are lists of {item, count}. Byproducts are ordinary
// outputs. Fluids are not items yet: an entry will later be written as
// {fluid = "water", count = 100} (count in litres), and loading rejects
// the fluid field until fluids exist.
// seconds is the time at speed 1 (a hand crafts at speed 1).
// made_in lists what can make the recipe: hand, furnace, assembler. The
// furnace makes recipes with one input and one output; two such furnace
// recipes may not share an input item.
// category is the recipe browser tab: materials, components, tools,
// machines, logistics, power, science.
// tags are free words for the browser's tag filter, each with a string
// recipe_tag_<tag>.
// channel is how the recipe becomes available: start (always), discovery
// (once every input item has been obtained), research (once technology,
// an id from technologies.sjson, is researched) or quest (a main quest
// gate, work item 0013; locked until then).
// Machine recipes take 2 s, inserters, belts, pipes, poles and chests
// 0.5 s (doc/content.md). Tools take 1 s.
recipes = [
	// Materials
	{id = "plank", inputs = [{item = "log", count = 1}], outputs = [{item = "plank", count = 4}], seconds = 0.5, made_in = ["hand", "assembler"], category = "materials", tags = ["wood"], channel = "start"}
	{id = "stick", inputs = [{item = "plank", count = 1}], outputs = [{item = "stick", count = 4}], seconds = 0.5, made_in = ["hand", "assembler"], category = "materials", tags = ["wood"], channel = "start"}
	{id = "stone_brick", inputs = [{item = "stone", count = 2}], outputs = [{item = "stone_brick", count = 1}], seconds = 3.2, made_in = ["furnace"], category = "materials", tags = ["smelting", "stone"], channel = "start"}
	{id = "charcoal", inputs = [{item = "log", count = 2}], outputs = [{item = "charcoal", count = 1}], seconds = 3.2, made_in = ["furnace"], category = "materials", tags = ["smelting", "wood", "fuel"], channel = "discovery"}
	{id = "iron_plate", inputs = [{item = "hematite", count = 1}], outputs = [{item = "iron_plate", count = 1}], seconds = 3.2, made_in = ["furnace"], category = "materials", tags = ["smelting", "iron"], channel = "start"}
	{id = "copper_plate", inputs = [{item = "chalcopyrite", count = 1}], outputs = [{item = "copper_plate", count = 1}], seconds = 3.2, made_in = ["furnace"], category = "materials", tags = ["smelting", "copper"], channel = "start"}
	{id = "tin_plate", inputs = [{item = "cassiterite", count = 1}], outputs = [{item = "tin_plate", count = 1}], seconds = 3.2, made_in = ["furnace"], category = "materials", tags = ["smelting", "tin"], channel = "discovery"}
	{id = "bronze_plate", inputs = [{item = "copper_plate", count = 3}, {item = "tin_plate", count = 1}], outputs = [{item = "bronze_plate", count = 4}], seconds = 6.4, made_in = ["furnace"], category = "materials", tags = ["smelting", "alloy", "copper", "tin"], channel = "discovery"}
	{id = "glass", inputs = [{item = "sand", count = 2}], outputs = [{item = "glass", count = 1}], seconds = 3.2, made_in = ["furnace"], category = "materials", tags = ["smelting", "sand"], channel = "discovery"}
	{id = "steel", inputs = [{item = "iron_plate", count = 5}, {item = "coal", count = 1}], outputs = [{item = "steel", count = 1}], seconds = 16, made_in = ["furnace"], category = "materials", tags = ["smelting", "alloy", "iron"], channel = "research", technology = "steel_processing"}
