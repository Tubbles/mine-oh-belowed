// The planets (work item 0168, doc/content.md, Planets). Every key is
// required but relief_shape (0189), landforms (0306), landmarks (0323),
// climate (0307), waters (0312) and cover (0311), which are off without
// them; the trees are doc/content.md, Trees (0197); the terrain field
// generates a planet from its record, the world seed and the sample
// spacing (generation_planet.odin). A world records the values it was
// made with in its world.sjson; once the session generates the field
// from them (0179), an edit here reshapes new worlds only.
planets = [
	{
		id = "home"
		radius_metres = 8000
		// The radii a new world offers, radius_metres the default among
		// them (work item 0179). Each must hold the bedrock depth and the
		// sea level below.
		radius_presets_metres = [4000, 8000, 16000]
		// 981 is Earth's.
		surface_gravity_centimetres_per_second_squared = 981
		// Below the radius, where bedrock starts: at least the relief's
		// depth (75 m with the landforms below) and the deep stone's 40 m.
		bedrock_depth_metres = 256
		// Above the radius. Every sample below it that is not ground is
		// sea, full and static outside the simulated chunks. The
		// landforms' lowland knots lie below it, so about a quarter of the
		// planet is sea, its floor down to about 54 m under the surface.
		sea_level_metres = -11
		// Sources of the water field: the first air sample above the
		// surface under each point. The pole is latitude 90 on +y. With
		// the default seed the first lies 688 m from the home at 8 km
		// (344 m at 4 km, 1377 m at 16 km) on a range's slope over a
		// valley, the tech demo's spring start and the pod's heading: its
		// stream runs about 390 m down and drops 64 m at 8 km (170 m at
		// 16 km, 24 m into a hollow at 4 km). The second lies 310 m from
		// the home at 8 km on the foot of a range: its stream runs about
		// 260 m down and drops 28 m into the home's plain. The waters below
		// add springs at the highlands' valley heads and lakes, and the tech
		// demo starts at the spring whose water falls furthest to the sea.
		springs = [
			{latitude_degrees = 79, longitude_degrees = 151}
			{latitude_degrees = 81, longitude_degrees = 139}
		]
		// Where the pod lies, its door to the first spring (work item 0179):
		// the surface under the point, in whole degrees; the players spawn
		// in its cabin (0199). The landforms keep a plain of home_metres
		// round it for every seed, so its crater's floor lies 10.2, 8.0 and
		// 9.8 m over the sea at 4, 8 and 16 km with the default seed, and
		// the planet's check keeps it dry for every seed. A planet without
		// landforms whose seed puts the crater's floor less than 1 m above
		// the sea moves a new world's home to the nearest dry whole degree
		// point within 5 degrees (0180).
		home = {latitude_degrees = 83, longitude_degrees = 132}
		// The impact crater the pod lies in (work item 0199), round the
		// home: a flat floor of floor_radius_metres at depth_metres below
		// the home's ground, a smooth bowl rising to the crest at
		// radius_metres, where a rim of rim_metres stands over the
		// surrounding ground and falls back to it over six times its
		// height. Here the bowl climbs 4 m over 8 m (37 degrees at its
		// steepest), the rim falls 1 m over 6 m, and the crater reaches
		// 18 m from the home.
		crater = {radius_metres = 12, depth_metres = 3, floor_radius_metres = 4, rim_metres = 1}
		// Trees (work items 0197 and 0310, doc/content.md, Trees): a forest
		// read off the climate, the height and the slope, none in the
		// home's clearing, below the sea or a lake, on a carving site or
		// on ground too steep. A world records the placement keys, the
		// forest and the species' placement keys and count in its
		// world.sjson; the grove keys place the trees of a world recorded
		// before the forest, and of a planet without one.
		trees = {
			// The grove lattice's cube edge; a grove centre per cube at most.
			grove_spacing_metres = 40
			// The share of the grove cubes that hold a grove.
			grove_share_percent = 50
			// A grove's reach; the chance of a tree falls with the square of
			// the distance from its centre.
			grove_radius_metres = 14
			// The tree lattice's cube edge; a tree per cube at most.
			tree_spacing_metres = 2
			// The chance of a tree where the forest's cover is full (at a
			// grove's centre without a forest).
			density_percent = 90
			// No tree within this of the home: the crater, which reaches
			// 18 m, and its rim.
			clearing_metres = 24
			// No tree where the ground rises more than this per 100 m (35
			// degrees).
			maximum_slope_percent = 70
			// The forest (work item 0310), optional, off without it. The
			// cover: a noise of 520 m mixed with 30% of a noise of 72 m
			// (the clearings), moved by 30% of the moisture's distance
			// from the middle, rising from -8% of the noise's range to
			// full over 28%, the cover 0 within 56 m of the home and fading
			// in to 112 m; at least 3% everywhere, the meadow too
			// (scattered trees, some 45 within 56 m of the home). No two
			// trees nearer than 0.9 m; the trees thin from a 40% slope.
			// Each species' weight moves by up to 100% with its own noise
			// of 80 m, so species gather in stands; a species' ranges fade
			// out over 3 degrees, 10% moisture, 10 m and 10% cover. About
			// 40% of the land is forest interior at 2 to 3 m spacing
			// (1300 to 2400 trees a hectare), 20% edge and 40% open.
			forest = {
				cover_wavelength_metres = 520
				clearing_wavelength_metres = 72
				clearing_percent = 30
				cover_threshold_percent = -8
				edge_percent = 28
				moisture_cover_percent = 30
				scatter_percent = 3
				meadow_metres = 56
				minimum_gap_millimetres = 900
				full_slope_percent = 40
				stand_wavelength_metres = 80
				stand_percent = 100
				species_fade_celsius = 3
				species_fade_moisture_percent = 10
				species_fade_metres = 10
				species_fade_cover_percent = 10
			}
			species = [
				// machine: a machines.sjson record of kind tree, its model.
				// tint multiplies the model's colours. The yield is count of
				// item after Mine held on the trunk (0265): a tree of at most
				// hand_felling_scale_percent falls to the hand in
				// hand_felling_milliseconds, any tree to the wooden, stone and
				// iron axe in axe_felling_milliseconds (the wooden axe four logs
				// at the block world's 1.5 s a log). In a forest the yield and
				// the times scale with the tree's scale (count at 100%). The
				// trunk is the capsule the walk, the aim and the placements
				// meet. The forest (0310) grows a species where the
				// temperature (celsius), the moisture (percent), the height
				// over the sea (metres) and the cover (percent) lie in its
				// ranges, by weight_percent among the species there, at a
				// scale_percent between the pair. Every species stands in
				// with the pine's model until its own (0329 to 0333).
				{id = "pine", machine = "pine_tree", tint = [236, 232, 214], item = "log", count = 4, hand_felling_scale_percent = 100, hand_felling_milliseconds = 10000, axe_felling_milliseconds = [6000, 4000, 2500], trunk_radius_millimetres = 180, trunk_height_millimetres = 2500, temperature_celsius = [-6, 16], moisture_percent = [15, 100], height_metres = [-20, 256], cover_percent = [0, 100], scale_percent = [45, 210], weight_percent = 100}
				{id = "broadleaf", machine = "pine_tree", tint = [196, 236, 160], item = "log", count = 5, hand_felling_scale_percent = 90, hand_felling_milliseconds = 12000, axe_felling_milliseconds = [7000, 5000, 3000], trunk_radius_millimetres = 180, trunk_height_millimetres = 2500, temperature_celsius = [6, 30], moisture_percent = [40, 100], height_metres = [-20, 70], cover_percent = [25, 100], scale_percent = [50, 220], weight_percent = 100}
				{id = "birch", machine = "pine_tree", tint = [250, 250, 236], item = "log", count = 3, hand_felling_scale_percent = 90, hand_felling_milliseconds = 8000, axe_felling_milliseconds = [5000, 3500, 2000], trunk_radius_millimetres = 180, trunk_height_millimetres = 2500, temperature_celsius = [-2, 18], moisture_percent = [35, 100], height_metres = [-20, 256], cover_percent = [5, 80], scale_percent = [40, 160], weight_percent = 60}
				{id = "snag", machine = "pine_tree", tint = [150, 132, 112], item = "log", count = 2, hand_felling_scale_percent = 80, hand_felling_milliseconds = 6000, axe_felling_milliseconds = [4000, 3000, 1800], trunk_radius_millimetres = 180, trunk_height_millimetres = 2500, temperature_celsius = [-8, 30], moisture_percent = [0, 60], height_metres = [-20, 256], cover_percent = [0, 100], scale_percent = [50, 150], weight_percent = 10}
				{id = "bush", machine = "pine_tree", tint = [176, 220, 150], item = "stick", count = 5, hand_felling_scale_percent = 45, hand_felling_milliseconds = 1500, axe_felling_milliseconds = [1000, 800, 600], trunk_radius_millimetres = 180, trunk_height_millimetres = 2500, temperature_celsius = [-4, 32], moisture_percent = [10, 100], height_metres = [-20, 256], cover_percent = [0, 70], scale_percent = [20, 45], weight_percent = 70}
			]
		}
		// Fill per surface sample per minute (254 a sample), applied by
		// the weather (M15).
		rain_fill_per_minute = 2
		rotation_period_seconds = 1200
		// The surface is the radius plus the landforms below and three
		// octaves of value noise read on the sphere, each its lattice
		// spacing and the most it raises or lowers the ground: the small
		// detail on the landforms. The amplitudes, the ledges' amplitude
		// and the basins' depth add up to 34 m at most (7 here).
		relief_octaves = [
			{wavelength_metres = 96, amplitude_metres = 4}
			{wavelength_metres = 32, amplitude_metres = 2}
			{wavelength_metres = 12, amplitude_metres = 1}
		]
		// The relief's shape (0189), each term off at zero. The ledges:
		// one more octave of value noise read through 1 - (1 - |noise|)
		// raised to the sharpness, with the noise's sign, so the ground
		// steps by up to twice the amplitude along the noise's zero
		// lines, the face steeper than the walkable angle where the noise
		// changes fast. The terraces: the first octave and the basins in
		// steps of the rise (under the mantle), each step's riser the
		// given thousandths of its span and the rest a flat tread. The
		// basins: where the first octave's noise lies below the threshold
		// (percent of its range), the ground drops by up to the depth with
		// the square of the share below it. Every term is off here: the
		// landforms make the basins, the terraces stepped only the old
		// long octave, and the ledges' half metre steps snaking along the
		// contours looked artificial (0322). A world made with them keeps
		// them through its record.
		relief_shape = {
			ledge_wavelength_metres = 32
			ledge_amplitude_millimetres = 0
			ledge_sharpness = 128
			terrace_rise_millimetres = 0
			terrace_riser_permille = 10
			basin_depth_metres = 0
			basin_threshold_percent = -30
		}
		// The landforms (work item 0306, doc/content.md, Planets): plains,
		// hills, ridged ranges and the valleys between them, fading in
		// from the home. The relief reaches 75 m below and 125 m above
		// the radius at most; the highest peaks stand about 100 m over the
		// sea.
		landforms = {
			// A noise of this wavelength moves the large terms' input by
			// up to warp_metres on each axis, which hides the lattice.
			warp_wavelength_metres = 1200
			warp_metres = 300
			// The region noise's wavelength: plains, hills and ranges
			// alternate over a few kilometres.
			region_wavelength_metres = 2400
			// The ground's height over the radius at the region noise's
			// -0.6, -0.45 ... 0.6 (a Catmull-Rom curve through them, flat
			// beyond): sea floor, coast, lowland, plain, hill, highland.
			region_heights_metres = [-60, -46, -26, -9, -5, -1, 5, 16, 30]
			// The share of the ranges at the same knots: none on the
			// lowlands, all of them on the highlands.
			region_ranges_percent = [0, 0, 0, 0, 15, 45, 80, 100, 100]
			// The share of the hills at the same knots.
			region_hills_percent = [0, 10, 30, 60, 80, 100, 100, 100, 100]
			// The ranges: crests of range_metres along the zero lines of
			// a noise of this wavelength.
			range_wavelength_metres = 800
			range_metres = 80
			// The spurs notch the crests into peaks and saddles: a crest
			// keeps 100 less spur_percent of its height between them.
			spur_wavelength_metres = 300
			spur_percent = 35
			// The hills: a noise of this wavelength raising or lowering
			// the ground by up to hill_metres.
			hill_wavelength_metres = 180
			hill_metres = 8
			// The plain round the home: home_metres over the radius within
			// calm_metres of it (the crater's reach at least), the terms
			// fading in out to wild_metres.
			home_metres = 2
			calm_metres = 120
			wild_metres = 600
		}
		// The landmarks (work item 0323, doc/content.md, Planets),
		// optional and needing the landforms: gorges and mesas in patches
		// of the landforms' first warp noise and sites on a lattice,
		// recorded by a world.
		landmarks = {
			// The patches: gorges where the noise lies below minus
			// gorge_mask_percent, mesas where it lies above
			// mesa_mask_percent, each fading in over mask_fade_percent
			// (percent of the noise's range).
			gorge_mask_percent = 8
			mesa_mask_percent = 16
			mask_fade_percent = 14
			// Their share at the landforms' region knots: the gorges cut
			// the plains and the high ground, the mesas stand on the
			// lowlands and plains.
			region_gorges_percent = [0, 0, 0, 0, 40, 100, 100, 100, 100]
			region_mesas_percent = [0, 0, 30, 100, 100, 70, 20, 0, 0]
			// The gorges: along the zero lines of a noise of the
			// wavelength, meandering with the hills by
			// gorge_meander_percent, gorge_width_permille of the noise's
			// range wide with a flat floor of gorge_floor_percent of it,
			// gorge_metres deep, the floor at least dry_metres over the
			// sea; only ground half the depth over it is cut.
			gorge_wavelength_metres = 700
			gorge_meander_percent = 18
			gorge_width_permille = 40
			gorge_floor_percent = 30
			gorge_metres = 26
			dry_metres = 1
			// The mesas and cliff bands: two tiers of mesa_metres where a
			// noise of the wavelength roughened by the hills by
			// mesa_rough_percent passes the threshold and the threshold
			// plus the tier, each edge rising over mesa_edge_permille of
			// the noise's range.
			mesa_wavelength_metres = 640
			mesa_rough_percent = 35
			mesa_threshold_percent = 12
			mesa_tier_percent = 12
			mesa_edge_permille = 30
			mesa_metres = 13
			// The sites: one per cube of site_spacing_metres at most, the
			// kind drawn by the shares and the rest of the cubes empty,
			// radius and height between the pair's values, buttes
			// stretched up to butte_stretch_percent along a drawn axis,
			// the outline wobbling by wobble_percent.
			site_spacing_metres = 448
			spire_percent = 30
			butte_percent = 25
			sinkhole_percent = 15
			spire_radius_metres = [10, 18]
			spire_metres = [28, 52]
			butte_radius_metres = [20, 40]
			butte_metres = [14, 28]
			butte_stretch_percent = 220
			sinkhole_radius_metres = [12, 24]
			sinkhole_metres = [9, 18]
			// Carved under their raise (0324): arches (a fin with an
			// opening through it, its length and height), grottos (a dome
			// with a chamber and a tunnel, its radius and height), mushroom
			// rocks (a cap on a stem, its radius and height).
			arch_percent = 10
			grotto_percent = 10
			mushroom_percent = 10
			arch_length_metres = [30, 48]
			arch_metres = [18, 28]
			grotto_radius_metres = [18, 28]
			grotto_metres = [12, 20]
			mushroom_radius_metres = [7, 12]
			mushroom_metres = [9, 16]
			wobble_percent = 30
		}
		// The climate and the ground's look (work item 0307,
		// doc/content.md, Planets), optional: without it the ground keeps
		// the palette's 256 m tint cubes and shows no grass, sand or snow.
		// A world records the field's seven keys; the look's keys are
		// these in every world.
		climate = {
			// The temperature at the sea level: a mean, moved by a noise of
			// this wavelength by up to the spread either side (90 percent of
			// the ground within half of it), and cooled by the lapse per
			// metre over the sea (warmed below it). The default seed's home
			// lies at 13.4 degrees at 8 km.
			temperature_wavelength_metres = 1600
			sea_level_celsius = 13
			temperature_spread_celsius = 14
			lapse_millicelsius_per_metre = 120
			// The moisture, likewise; the home lies at 88 percent at 8 km.
			moisture_wavelength_metres = 1100
			moisture_percent = 55
			moisture_spread_percent = 70
			// The grass at full light, rows cold, temperate and hot (at
			// grass_cold_celsius, their mean, grass_hot_celsius), each row
			// dry, moderate and wet, blended between them.
			grass_colors = [
				[146, 150, 104], [80, 124, 78], [44, 98, 70]
				[190, 182, 82], [96, 166, 58], [52, 140, 58]
				[220, 180, 90], [158, 180, 56], [60, 160, 50]
			]
			grass_cold_celsius = 2
			grass_hot_celsius = 26
			// Snow lies below this temperature, fading in over the fade: at
			// the mean climate from about 95 m over the sea, lower where the
			// sea level is colder.
			snow_celsius = 0
			snow_fade_celsius = 3
			snow_color = [210, 218, 232]
			// Sand lines the sea up to this height over the sea level and
			// covers its floor, fading over the fade.
			sand_metres = 1
			sand_fade_metres = 2
			sand_color = [208, 188, 142]
		}
		// The waters (work item 0312, doc/content.md, Planets), optional:
		// springs at the valley heads of the highlands and lakes in their
		// basins round the home, found once per session from the seed; a
		// world records these keys.
		waters = {
			// The finder's reach round the home (at most half the radius)
			// and its grid's cell.
			reach_metres = 2500
			grid_metres = 16
			// No spring and no lake within this of the home.
			clearing_metres = 250
			// A spring heads a channel draining at least this area.
			spring_catchment_square_metres = 4000
			// A spring stands at least this high over the sea.
			spring_minimum_metres = 25
			// Springs keep this far apart and from the springs above, so a
			// player's simulated set holds one at most.
			spring_spacing_metres = 400
			// A lake is at least this deep and this wide.
			lake_minimum_depth_millimetres = 1500
			lake_minimum_area_square_metres = 400
			// A lake fits a window of this edge round its pit.
			lake_maximum_metres = 384
			// A lake stands this far under its pour point.
			lake_margin_millimetres = 500
		}
		// The ground cover (work item 0311, doc/content.md, Planets),
		// optional and needing the climate: tufts, flowers, ferns and stones
		// scattered on the ground near the eye, drawn only, never recorded,
		// so an edit here re-dresses every world. Per kind:
		// - what it is: an id, a shape (blades, flower, fern, pebble or
		//   crystal) of parts blades, flowers or fronds (0 for a stone), and
		//   how many stand on a hundred square metres where it grows fully;
		// - where it grows: the temperature, the moisture and the slope
		//   ranges, least first, fading out past them over the fades, and
		//   the share of each surface (percent: grass, sand, snow, rock on
		//   steep topsoil, stone, the three ores), raised
		//   where its surfaces meet others by boundary_percent;
		// - its patches: a noise of patch_wavelength_metres (0 none), the
		//   kind growing above patch_threshold_percent of its range, full
		//   over patch_edge_percent;
		// - its size in millimetres, least and most, sunk sink_percent of its
		//   height into the ground;
		// - its colour: from the grass under it, the ground's strata tint
		//   (scaled by the first colour over 128) or its colors by hash;
		// - its reach: drawn out to far_metres, thinning from near_metres.
		cover = {
			kinds = [
				{
					id = "grass", shape = "blades", parts = 9, per_hundred_square_metres = 600
					temperature_celsius = [2, 30], temperature_fade_celsius = 6
					moisture_percent = [55, 100], moisture_fade_percent = 30
					slope_degrees = [0, 32], slope_fade_degrees = 8
					surfaces = {grass = 100, sand = 15, snow = 0, rock = 0, stone = 0, hematite = 0, chalcopyrite = 0, coal = 0}
					boundary_percent = 0
					patch_wavelength_metres = 9, patch_threshold_percent = -45, patch_edge_percent = 60
					width_millimetres = [180, 420], height_millimetres = [140, 460], sink_percent = 0
					color_from = "grass", colors = [[128, 128, 128]]
					near_metres = 12, far_metres = 40
				}
				{
					id = "flowers", shape = "flower", parts = 3, per_hundred_square_metres = 200
					temperature_celsius = [7, 26], temperature_fade_celsius = 4
					moisture_percent = [45, 90], moisture_fade_percent = 12
					slope_degrees = [0, 20], slope_fade_degrees = 6
					surfaces = {grass = 100, sand = 0, snow = 0, rock = 0, stone = 0, hematite = 0, chalcopyrite = 0, coal = 0}
					boundary_percent = 0
					patch_wavelength_metres = 7, patch_threshold_percent = 15, patch_edge_percent = 30
					width_millimetres = [120, 260], height_millimetres = [180, 420], sink_percent = 0
					color_from = "colors", colors = [[236, 232, 220], [232, 196, 64], [156, 116, 196], [204, 84, 64]]
					near_metres = 8, far_metres = 32
				}
				{
					id = "ferns", shape = "fern", parts = 7, per_hundred_square_metres = 90
					temperature_celsius = [4, 24], temperature_fade_celsius = 4
					moisture_percent = [65, 100], moisture_fade_percent = 10
					slope_degrees = [0, 40], slope_fade_degrees = 10
					surfaces = {grass = 100, sand = 0, snow = 0, rock = 40, stone = 0, hematite = 0, chalcopyrite = 0, coal = 0}
					boundary_percent = 0
					patch_wavelength_metres = 13, patch_threshold_percent = -10, patch_edge_percent = 40
					width_millimetres = [500, 1100], height_millimetres = [350, 800], sink_percent = 0
					color_from = "grass", colors = [[104, 120, 96]]
					near_metres = 12, far_metres = 40
				}
				{
					id = "pebbles", shape = "pebble", parts = 0, per_hundred_square_metres = 250
					temperature_celsius = [-100, 100], temperature_fade_celsius = 1
					moisture_percent = [0, 100], moisture_fade_percent = 1
					slope_degrees = [0, 60], slope_fade_degrees = 10
					surfaces = {grass = 3, sand = 50, snow = 0, rock = 100, stone = 100, hematite = 0, chalcopyrite = 0, coal = 0}
					boundary_percent = 70
					patch_wavelength_metres = 6, patch_threshold_percent = -20, patch_edge_percent = 50
					width_millimetres = [40, 140], height_millimetres = [30, 90], sink_percent = 35
					color_from = "ground", colors = [[128, 128, 128]]
					near_metres = 6, far_metres = 20
				}
				{
					id = "dry_stones", shape = "pebble", parts = 0, per_hundred_square_metres = 140
					temperature_celsius = [-100, 100], temperature_fade_celsius = 1
					moisture_percent = [0, 30], moisture_fade_percent = 15
					slope_degrees = [0, 35], slope_fade_degrees = 8
					surfaces = {grass = 100, sand = 60, snow = 0, rock = 0, stone = 0, hematite = 0, chalcopyrite = 0, coal = 0}
					boundary_percent = 0
					patch_wavelength_metres = 11, patch_threshold_percent = -25, patch_edge_percent = 50
					width_millimetres = [50, 220], height_millimetres = [40, 140], sink_percent = 35
					color_from = "ground", colors = [[136, 130, 120]]
					near_metres = 8, far_metres = 28
