objective_recycled = "Items recycled"
objective_produce_fluid = "Produce"
objective_generator_gas = "Litres of gas burned by generators"
objective_veins_assayed = "Veins assayed"
objective_core_samples = "Core samples taken"
objective_bore_drill_units = "Units drawn by bore drills"
objective_turbine_energy = "Kilojoules from hydro turbines"
objective_schematics_found = "Schematics found"
objective_ship = "Ship"
