// Technology descriptions (work item 0070), under the cost on the
// technology screen.
describe_technology_automation = "The assembler. The first thing research buys is a machine that does the crafting."
describe_technology_logistics = "The splitter and the filter inserter: belts that share and arms that choose."
describe_technology_electric_mining = "The electric mining drill and the power switch. Twice the burner drill's rate and no more coal runs."
describe_technology_optics = "The lamp. Research that moves the end of the working day."
describe_technology_steel_processing = "Steel, and the steel furnace at double speed. Five iron plates and a coal to a bar."
describe_technology_fluid_handling = "The pump and the 25,000 litre storage tank. Liquids stop depending on the terrain."
describe_technology_prospecting = "The core sample drill and the magnetometer. Find the veins before the drills do."
describe_technology_ore_processing = "The crusher and the washer, and a recipe each to crush and wash six ores. Low grade ore becomes ore again."
describe_technology_recycling = "The recycler: a quarter back on anything overproduced."
describe_technology_oil_processing = "The tar pit pump, the refinery and the flare stack. Granted with the extraction rights, never researched in a lab."
describe_technology_cracking = "The cracking unit. Heavy oil to light, light oil to gas, with water."
describe_technology_plastics = "The chemical plant, plastic and sulfur. What the buyers actually want."
describe_technology_logistics_science = "Science pack 2, from plastic, wire and a gear. The deep strata, electrolysis and the rockets all ask for it."
describe_technology_fast_belts = "Belts, ramps and lifts at 3.75 blocks a second, twice the throughput."
describe_technology_hydro_power = "The hydro turbine: power from flowing water, 10 kW per level of flow."
describe_technology_electric_grid = "The big pole and the substation. Power carried 24 blocks and supplied 18 blocks across."
describe_technology_fast_inserters = "The fast and the long inserter: 138 items a minute, or a reach of two cells."
describe_technology_renewable_plastics = "The wood gasifier and plastic from wood gas and charcoal. Slower, but the trees grow back."
describe_technology_bitumen_paving = "Bitumen from heavy oil, and asphalt from bitumen and gravel. Two byproducts become a road."
describe_technology_combustion_power = "The combustion generator: 600 kW from gas that would otherwise be flared."
describe_technology_deep_mining = "The bore drill, mining fluid and the bauxite recipes. The permit for the deep strata, granted by the venture, never researched."
describe_technology_seismic_survey = "The thumper charge. A pattern of shots outlines the deep veins over a wide area."
describe_technology_electrolysis = "The electrolyser, alumina, aluminium plate and silicon. Electricity turned into the lightest metal on the manifest."
describe_technology_rocket_program = "The launch pad, the rocket structure and the guidance unit. Granted with the launch pad permit, never researched."
describe_technology_rocketry = "Rocket fuel and the cargo capsule: the rest of a rocket."
describe_technology_mining_productivity = "Every level adds 10 percent to every drill's output and costs 1.5 times the last. The venture expects a level every quarter."
describe_technology_research_speed = "Every level makes every lab 10 percent faster and costs 1.5 times the last."

