// Item descriptions (work item 0070): the recipe browser shows the first
// output item's under a recipe's facts. One to three sentences in the
// venture's register, each with one concrete fact.
describe_item_log = "Timber from any of the asset's trees. Planks, sticks, poles, and 2 MJ in a firebox. The only resource on the lease that grows back."
describe_item_stone = "Granite from the stratum under the topsoil. Furnaces, bricks and the first pickaxe start here. There is so much of it that the venture does not count it."
describe_item_dirt = "Topsoil over the stone. No recipe takes it. It levels ground and fills holes, and the survey lists it as overburden."
describe_item_sand = "Silica from beaches, dunes and the spoil of copper veins. Two make one pane of glass. Pure silica melts at 1713 degrees Celsius."
describe_item_clay = "Fine sediment, dried back out of washer mud in a furnace. Kaolinite, mostly. It fires into brick."
describe_item_gravel = "Broken rock, the spoil iron and coal veins throw up with their ore. With 30 litres of water it sets as concrete. Left alone it becomes a heap the lease does not mention."
describe_item_coal = "Bituminous coal from the veins of the plains, hills, steppe and wetland. 4 MJ a lump in any firebox, and the carbon in steel and plastic."
describe_item_hematite = "Iron ore, Fe2O3, red and heavy at 5.3 tonnes a cubic metre. Up to 70 percent iron by mass. One smelts to one iron plate and one slag."
describe_item_chalcopyrite = "Copper iron sulfide, CuFeS2, brassy yellow in the rock and about a third copper by mass. The copper veins carry some cassiterite with it."
describe_item_cassiterite = "Tin oxide, SnO2, dark and dense, found with chalcopyrite in the copper veins. Nearly 79 percent tin, all of it bound for bronze."
describe_item_galena = "Lead sulfide, PbS, grey cubes that split along clean faces. 87 percent lead at 7.6 tonnes a cubic metre. Its veins carry sphalerite too."
describe_item_sphalerite = "Zinc sulfide, ZnS, the main zinc ore on any planet. Zinc veins lie in the hills, the desert and the badlands. The zinc goes into brass."
describe_item_pentlandite = "Iron nickel sulfide, found with chalcopyrite as in the nickel belts back home. About a third nickel. Its veins run under desert, plains, badlands and the cold barrens."
describe_item_hematite_low_grade = "Hematite with too much rock in it for the furnace. A vein gives more of it as it depletes, from 10 up to 60 percent. Crush and wash it first."
describe_item_chalcopyrite_low_grade = "Chalcopyrite diluted by host rock. The furnace refuses it. The crusher and the washer recover it, and head office books the recovery as yield."
describe_item_cassiterite_low_grade = "Tin ore below smelting grade. A depleting copper vein gives more of it every hour. Crusher first, then washer."
describe_item_galena_low_grade = "Galena too lean to smelt. Two of it crush to two crushed galena and one gravel."
describe_item_sphalerite_low_grade = "Zinc ore below furnace grade. The share rises from 10 to 60 percent as a vein runs down, and the invoice does not adjust."
describe_item_pentlandite_low_grade = "Nickel ore still locked in its host rock. Crushing frees it, washing sorts it, and the mud is yours to keep."
describe_item_bauxite = "Red laterite rich in aluminium hydroxides, reached only through the deep veins. Washed with 30 litres of water it gives alumina. The red is iron oxide, which leaves as mud."
describe_item_bauxite_low_grade = "Bauxite too full of clay and quartz for the washer. Crush it first. The deep veins give more of it as they run down."
describe_item_gold_ore = "Native gold in quartz, from cave walls and deep veins. 19.3 tonnes a cubic metre, melting at 1064 degrees Celsius. Free trade takes it at eight credit a lump."
describe_item_quartz = "Silicon dioxide, hardness 7, from gold quartz and the deep strata. The electrolyser reduces it to silicon, the furnace fuses it into glass."
describe_item_sapling = "A young tree dropped by decaying leaves after a felling. Nothing on the outpost uses it. The venture has not committed to replanting."
describe_item_mud = "Wet fines from the washer and the wetland floor. A furnace dries it back into clay. It also places as a mud block, which is where most of it ends up."
describe_item_slag = "Glassy silicate waste. Every plate and alloy leaves one behind. A crusher turns it into gravel, a heap turns it into scenery."
describe_item_plank = "Sawn timber, four from each log. Chests, pickaxes and sticks. Burns for 1 MJ if it comes to that."
describe_item_stick = "Four from a plank. Handles for every hand tool on the outpost. Burns for half a megajoule."
describe_item_stone_brick = "Two stone fired into one block. The steel furnace, the alloy furnace and the wood gasifier are lined with it."
describe_item_charcoal = "Wood cooked without air, nearly pure carbon. 3 MJ a lump. The wood gasifier makes it as a byproduct, and a schematic makes steel with it."
describe_item_iron_plate = "One hematite, 3.2 seconds in a stone furnace. Pure iron melts at 1538 degrees Celsius. Nearly everything the outpost builds starts as one of these."
describe_item_copper_plate = "One chalcopyrite, one plate. Copper melts at 1085 degrees Celsius and conducts better than anything else the asset holds cheaply. Wire, circuits and science."
describe_item_tin_plate = "Tin melts at 232 degrees Celsius, the lowest of the outpost's metals. Alone it is soft. With copper it becomes bronze."
describe_item_bronze_plate = "Three parts copper to one of tin, which is bell metal rather than statuary. Hard and slow to corrode. The alloy furnace makes four at a time."
describe_item_glass = "Silica fused in a furnace, two sand to a pane. Every lamp needs one. Quartz makes it one for one."
describe_item_steel = "Iron with a little carbon, five plates and one coal to a bar in the alloy furnace. Stronger than iron, and twelve credit a bar on the venture's price list."
describe_item_crushed_hematite = "Low grade hematite broken to gravel size so water can separate ore from rock. One washes to one hematite and one mud."
describe_item_crushed_chalcopyrite = "Chalcopyrite broken out of its host rock, ready for the washer. 30 litres of water per piece."
describe_item_crushed_cassiterite = "Crushed tin ore. Cassiterite weighs about 7 tonnes a cubic metre, so it settles out of the wash water first."
describe_item_crushed_galena = "Crushed lead ore waiting for the washer. At 7.6 tonnes a cubic metre, galena parts from its rock more willingly than most."
describe_item_crushed_sphalerite = "Crushed zinc ore. One piece and 30 litres of water give back one sphalerite and one mud."
describe_item_crushed_pentlandite = "Crushed nickel ore. One piece and 30 litres of water in the washer give one pentlandite and one mud."
describe_item_lead_plate = "Soft, heavy lead that melts at 327 degrees Celsius. No recipe on the outpost takes it yet. Free trade pays two credit a plate."
describe_item_zinc_plate = "Zinc melts at 420 degrees Celsius and boils at 907, so the furnace keeps it well short of that. It goes into brass."
describe_item_nickel_plate = "Nickel melts at 1455 degrees Celsius and shrugs off corrosion. No recipe on the outpost takes it yet. Free trade pays three credit a plate."
describe_item_brass_plate = "Two parts copper to one of zinc, close to cartridge brass. Machines cleanly and does not spark. The venture put brass up as collateral for the oil rights."
describe_item_crushed_bauxite = "Low grade bauxite broken for the washer. Two crush to two of this and one gravel."
describe_item_alumina = "Aluminium oxide, Al2O3, washed out of bauxite. It melts at 2072 degrees Celsius, so the electrolyser dissolves it rather than melting it."
describe_item_aluminium_plate = "Two alumina through the electrolyser. A third of the density of steel, melting at 660 degrees Celsius. Industrial smelters spend about 14 megawatt hours on a tonne of it."
describe_item_gold_plate = "Gold smelted from its ore. It never tarnishes and sells for twenty credit a plate, the dearest plate on the venture's list."
describe_item_silicon = "Silicon reduced from two quartz, melting at 1414 degrees Celsius. Guidance units are built on it, and the chip fab upstairs buys it by the hundred."
describe_item_iron_gear = "Two iron plates cut into one gear. Drills, belts, engines and science packs all turn on them."
describe_item_iron_rod = "Two rods from one iron plate. No recipe on the outpost takes them yet, which has not stopped anyone making them."
describe_item_copper_wire = "Two lengths from one copper plate. Poles, circuits and lamps. Copper conducts at 59.6 megasiemens a metre, which the venture rounds to adequate."
describe_item_electronic_circuit = "One iron plate and three copper wire on a board. Every electric machine needs them, and the first buyer on the asset wanted a hundred."
describe_item_pipe = "One iron plate rolled into a pipe. Placed, a segment holds 100 litres and passes 1200 a second."
describe_item_science_pack_1 = "A copper plate and a gear, packaged as research material. A lab consumes one per unit. The venture files the results as its own intellectual property."
describe_item_plastic_bar = "Polyethylene. Petroleum gas and coal give two bars a batch, wood gas and charcoal give one. It does not recycle."
describe_item_sulfur = "Yellow, brittle, melting at 115 degrees Celsius. Recovered from petroleum gas and water in the chemical plant. Mining fluid, thumper charges and rocket fuel need it."
describe_item_bitumen = "The heaviest fraction, 40 litres of heavy oil to a lump. With gravel it becomes asphalt. It is what is left once nothing lighter can be sold."
describe_item_science_pack_2 = "Plastic, wire and a gear, made only in an assembler. The second tier of research: fast belts, electrolysis and the rockets ask for it. Fifteen credit a pack on the price list."
describe_item_wooden_pickaxe = "Three planks and two sticks, tool tier 1: stone, coal, hematite and chalcopyrite. It never wears out, which is the one thing it does well."
describe_item_stone_pickaxe = "A stone head on a stick, tool tier 2. Reaches the tin, lead, zinc and nickel ores."
describe_item_iron_pickaxe = "Tool tier 3, the highest the asset asks for. Deep stone and gold quartz yield to it. Carried anywhere in the pockets, it opens every block on the lease."
describe_item_geologists_hammer = "Strike an outcrop to assay its vein: ore mix and size class, marked on the map. It also mines to tool tier 2. The oldest prospecting instrument there is, and still the cheapest."
describe_item_magnetometer = "Feels for iron bearing veins within 30 blocks, buried ones included. Hematite is only weakly magnetic, so it is close range work."
describe_item_thumper_charge = "A sulfur charge fired into the ground. Each shot images the deep veins within 32 blocks. Four from five sulfur and two iron plates, consumed on firing."
describe_item_stone_furnace = "Five stone around a firebox. One plate every 3.2 seconds on 90 kW of fuel. The outpost's first machine, and for a while its only one."
describe_item_steel_furnace = "A steel shell with a brick lining, twice the speed of a stone furnace on the same 90 kW. Six steel and ten bricks."
describe_item_burner_mining_drill = "A coal fired drill built around a stone furnace. 15 ore a minute on an iron vein, 150 kW of fuel while it works."
describe_item_electric_mining_drill = "Three by three, 30 ore a minute on 90 kW. Its revival port keeps an exhausted vein producing at half rate on mining fluid."
describe_item_burner_inserter = "An arm that moves 36 items a minute and burns 94 kW of fuel while it swings. The first automation the outpost can afford."
describe_item_inserter = "Moves 50 items a minute on 13 kW. It needs a circuit, which is where the outpost stops running on coal alone."
describe_item_filter_inserter = "An inserter with one filter slot, moving only the item it is set to. Sorting ore from spoil starts here."
describe_item_fast_inserter = "138 items a minute on 46 kW. Keeps pace with a belt where a plain inserter falls behind."
describe_item_long_inserter = "Reaches two cells behind and two ahead at 50 items a minute. For machines that do not stand flush against the belt."
describe_item_belt = "Two lanes at 1.875 blocks a second, 900 items a minute. Two from a plate and a gear. The cheapest way to stop carrying things."
describe_item_belt_ramp = "A belt that climbs or falls one block per block of run. Up or down is chosen when it is placed."
describe_item_belt_lift = "A vertical belt block that stacks. Items go up as fast as they go along."
describe_item_belt_2 = "Twice the speed: 3.75 blocks a second, 1800 items a minute. A steel bar in every block."
describe_item_belt_ramp_2 = "A ramp at fast belt speed, one block of rise per block of run."
describe_item_belt_lift_2 = "A lift at fast belt speed, stacking vertically at 3.75 blocks a second."
describe_item_splitter = "Stands across two belts and shares their items, with an input priority, an output priority and a filter. Five circuits and four belts."
describe_item_wooden_chest = "Four planks, sixteen slots. Enough to keep a furnace's output off the ground."
describe_item_iron_chest = "Eight iron plates, thirty two slots. Twice the wooden chest in the same cubic metre."
describe_item_offshore_pump = "Set at the water's edge, it lifts 1200 litres a second on 60 kW, up to 6 metres above its outlet. Rivers and lakes never run dry for it."
describe_item_pump = "Moves 1200 litres a second from input to output, on 30 kW, and lifts liquid up to 30 metres above its outlet. Liquids run downhill on their own and climb only as high as a pump's head."
describe_item_storage_tank = "Three by three by three, 25,000 litres of any one fluid, liquid or gas. Twenty steel."
describe_item_boiler = "Turns 60 litres of water a second into as much steam, burning 1.8 MW of fuel. One feeds two steam engines."
describe_item_fuel_generator = "75 kW from coal, logs or planks, enough for the offshore pump that starts the boilers. It wastes three quarters of every lump."
describe_item_steam_engine = "900 kW from 30 litres of steam a second. The venture released the schematics once the outpost proved it could run without you."
describe_item_small_pole = "A log and two copper wires. Powers a 5 by 5 area 4 blocks high, and wires to poles within 7 blocks."
describe_item_big_pole = "A steel mast 6 blocks tall, wiring to poles 24 blocks away. It powers only the 3 by 3 around its foot. For distance, not coverage."
describe_item_substation = "Powers an 18 by 18 area 6 blocks high and wires 18 blocks. Ten steel and five circuits, for the factory floor."
describe_item_lamp = "Light level 14 on 5 kW. Night on the asset changes nothing but the light, and that is reason enough."
describe_item_power_switch = "Joins the networks it wires while on and splits them while off. For isolating a brownout before it spreads."
describe_item_assembler_1 = "Crafts hand recipes and a few that hands cannot, at half hand speed, on 75 kW. It does not take breaks."
describe_item_lab = "Consumes science packs to research technologies, on 60 kW. The venture owns whatever it finds."
describe_item_core_sample_drill = "Drills one column for 60 seconds on 40 kW and reports the strata and any deep vein below. It confirms. It does not search."
describe_item_crusher = "Breaks low grade ore into crushed ore, and slag into gravel. 60 kW."
describe_item_washer = "Washes crushed ore with 30 litres of water a piece into ore and mud. It also sets gravel into concrete and washes bauxite into alumina."
describe_item_alloy_furnace = "A two input furnace for steel, bronze and brass, burning 180 kW. Two stone furnaces, ten bricks and four gears."
describe_item_recycler = "Reverses a recipe and gives back a quarter of its inputs, rounded down. 100 kW. The sink for whatever nobody ordered."
describe_item_tar_pit_pump = "Draws 600 litres of crude oil a minute from a tar pit, on 60 kW. Two keep one refinery busy."
describe_item_refinery = "Five by five. Splits 100 litres of crude oil into 45 of petroleum gas, 30 of light oil and 25 of heavy oil every 5 seconds, on 400 kW."
describe_item_cracking_unit = "Breaks heavy oil into light oil and light oil into petroleum gas, with water, on 200 kW. For when the buyers want gas and the tanks hold everything else."
describe_item_flare_stack = "Burns up to 60 litres of gas a second once its port is 90 percent full. A relief valve with a flame on top."
describe_item_combustion_generator = "600 kW from petroleum gas, wood gas or solid fuel. Gas that would have gone to the flare goes to the grid."
describe_item_hydro_turbine = "Stands in flowing water: 10 kW per level of flow in its footprint, up to 400 kW. No fuel and no ports."
describe_item_chemical_plant = "Gas and coal into plastic, gas and water into sulfur, heavy oil into bitumen, and more. 210 kW, three by three by three."
describe_item_wood_gasifier = "Bakes four logs into 60 litres of wood gas and one charcoal, on 90 kW. The renewable route: slow, and land hungry."
describe_item_bore_drill = "Four by four by four. Bores 180 seconds down to a deep vein 40 to 120 blocks below, then draws 48 ore a minute on 300 kW."
describe_item_electrolyser = "Alumina to aluminium and quartz to silicon, on 500 kW. The hungriest machine on the grid."
describe_item_leaves = "Leaves from any of the asset's trees. Placed by hand they stay until a log near them is felled. No recipe takes them."
describe_item_tar = "Tar sand from the tar flats, bitumen soaked and sticky. The crude oil sits in the pits between it."
describe_item_deep_stone = "The deep stratum, too hard for anything short of an iron pickaxe. Otherwise it builds like stone."
describe_item_spent_rock = "What an outcrop turns into when its vein is exhausted. The visible cost of mining, and a perfectly good building block."
describe_item_torch = "Sixty four came in the landing kit, light level 14 each. No recipe on the outpost makes more, so place them where they count."
describe_item_concrete = "Gravel set with 30 litres of water in the washer. Foundations, floors and the launch pad, which takes a hundred."
describe_item_stone_slab = "Half a block of stone, two from one. Floors a half step lower."
describe_item_stone_stairs = "Four from three stone. Each stair rises half a block towards its back."
describe_item_concrete_slab = "Half a block of concrete, two from one."
describe_item_concrete_stairs = "Concrete stairs, four from three blocks."
describe_item_plank_slab = "Half a block of plank, two from one."
describe_item_plank_stairs = "Plank stairs, four from three planks."
describe_item_grass_tuft = "Ground cover from the plains and the forest. It places back as itself and does nothing else."
describe_item_tall_grass = "Knee high grass from the plains. The venture has found no market for it."
describe_item_flower_red = "A red flower from the plains. The survey logged it. The buyers did not."
describe_item_flower_yellow = "A yellow flower from the plains. One credit as free trade, which is optimistic."
describe_item_dead_bush = "A dry shrub from the steppe, the badlands and the desert. Something grew here before the lease."
describe_item_reeds = "Wetland reeds rooted in mud. No use to the factory. They place back wherever you like."
describe_item_brick = "Clay fired at about 1000 degrees Celsius. A building block made from the mud the washers leave behind."
describe_item_asphalt = "Paving from the two things the outpost makes without trying: heavy oil and gravel. Four blocks from two bitumen and four gravel."
describe_item_snow = "Snow from the cold barrens. It places back as snow. The outpost has no use for it."
describe_item_schematic_low_grade_iron_plate = "A recovered schematic: smelt two low grade hematite straight into one iron plate, no crusher needed. Read it from the hotbar."
describe_item_schematic_charcoal_steel = "A recovered schematic: steel from five iron plates and two charcoal instead of coal. Read it from the hotbar."
describe_item_schematic_wood_gas_plastic = "A recovered schematic: plastic from 40 litres of wood gas alone. Read it from the hotbar."
describe_item_schematic_slag_concrete = "A recovered schematic: two slag and 30 litres of water set into concrete in the washer. Waste into foundations."
describe_item_schematic_wood_gas_rocket_fuel = "A recovered schematic: rocket fuel from wood gas and coal. Whoever held the lease before apparently flew on trees."
describe_item_launch_pad = "Nine by nine. Assembles a rocket from its parts and 200 litres of fuel, and sends the cargo up to the buyers. A hundred steel and a hundred concrete."
describe_item_rocket_structure = "Ten aluminium plates and five steel, ten seconds in an assembler. A rocket takes ten."
describe_item_guidance_unit = "Five silicon, ten copper wire and five plastic bars. A rocket takes two, and arrives."
describe_item_cargo_capsule = "Twenty steel and ten plastic bars around the eight slots of cargo the buyers pay for. A rocket takes one."

