// Machine descriptions (work item 0070), dim under the name in the
// machine panel: how the machine runs.
describe_machine_wooden_chest = "Sixteen slots of storage the venture does not charge rent for, yet."
describe_machine_iron_chest = "Thirty two slots in one cubic metre."
describe_machine_stone_furnace = "Ore above, fuel below, plate and slag out. 18.75 plates a minute while the fire lasts."
describe_machine_steel_furnace = "Two plates for every one a stone furnace makes, on the same fuel. The slag doubles too."
describe_machine_drop_capsule = "The venture's delivery point on the pad. Rewards land here and deliveries go in here. Eight slots, no refunds."
describe_machine_schematic_crate = "Left in the caves by whoever held the lease before. One schematic inside, now the venture's property."
describe_machine_belt = "Two lanes at 1.875 blocks a second. Items ride until something takes them or the belt ends."
describe_machine_belt_ramp = "One block of rise per block of run."
describe_machine_belt_lift = "Carries items straight up or down, one block per block."
describe_machine_belt_2 = "Two lanes at 3.75 blocks a second. A belt line ends where the speed changes."
describe_machine_belt_ramp_2 = "A ramp at fast belt speed."
describe_machine_belt_lift_2 = "A lift at fast belt speed."
describe_machine_burner_inserter = "Takes from the cell behind, drops into the cell ahead. Burns fuel only while the arm moves."
describe_machine_inserter = "50 items a minute, drawing 13 kW only while the arm moves."
describe_machine_filter_inserter = "Moves only the item in its filter. An empty filter moves nothing."
describe_machine_fast_inserter = "138 items a minute, 46 kW while moving."
describe_machine_long_inserter = "Picks up two cells behind and drops two cells ahead."
describe_machine_burner_mining_drill = "Taps the vein under its footprint and drops ore and spoil ahead of its arrow. 15 ore a minute on an 80 percent vein."
describe_machine_electric_mining_drill = "30 ore a minute plus spoil on 90 kW. Mining fluid in the revival port keeps an exhausted vein giving at half rate, 10 litres a unit."
describe_machine_bore_drill = "180 powered seconds of boring before the first ore. A brownout makes it longer."
describe_machine_splitter = "Shares items between two belts. The priorities and the filter are set here."
describe_machine_pipe = "100 litres in each segment, up to 1200 litres a second through each joint. One fluid per network."
describe_machine_offshore_pump = "1200 litres of water a second into its port while it has 60 kW and there is room downstream."
describe_machine_boiler = "Water in, steam out, 60 litres a second while it burns. 1.8 MW is 27 lumps of coal a minute."
describe_machine_fuel_generator = "Up to 75 kW from the fuel in its slot at 25 percent: a lump of coal lasts 13 seconds at full output."
describe_machine_steam_engine = "Up to 900 kW, 30 kJ from each litre of steam. It draws only what the grid asks for."
describe_machine_storage_tank = "One port on every face. One fluid at a time, liquid or gas."
describe_machine_pump = "Pushes fluid at 1200 litres a second and lifts liquid up to 30 metres above its outlet. Unpowered, it is a pipe that does not flow."
describe_machine_tar_pit_pump = "10 litres of crude oil a second from the tar pit in front of its intake."
describe_machine_flare_stack = "Burns gas only above 90 percent full, so consumers on the network are served first. What it burns is counted as voided."
describe_machine_combustion_generator = "Gas in the port first, then solid fuel from the slot. Up to 600 kW, drawn as the grid asks."
describe_machine_hydro_turbine = "Reads the flowing water in its footprint every tick. Still water gives nothing."
describe_machine_small_pole = "Supplies a 5 by 5 by 4 volume and wires to every pole within 7 blocks."
describe_machine_big_pole = "Wires reach 24 blocks. The supply covers only 3 by 3."
describe_machine_substation = "Supplies 18 by 18 by 6 and wires 18 blocks. One replaces a field of small poles."
describe_machine_power_switch = "On, it joins the networks it wires. Off, it splits them."
describe_machine_lamp = "Lit while its network is satisfied above half. 5 kW."
describe_machine_assembler_1 = "Speed 0.5: every recipe takes twice its listed time. 75 kW while working."
describe_machine_crusher = "Low grade ore or slag in, crushed ore or gravel out. The loaded input picks the recipe."
describe_machine_washer = "Needs water in its port. Crushed ore, gravel or bauxite in, product and mud out."
describe_machine_alloy_furnace = "Two inputs, one fuel slot, product and slag out. The loaded pair picks steel, bronze or brass."
describe_machine_recycler = "Returns a quarter of the first recipe's inputs, rounded down, at that recipe's time."
describe_machine_refinery = "Each fraction leaves by its own face: gas, light oil, heavy oil. One full output stops the whole refinery."
describe_machine_cracking_unit = "Heavy or light oil in, whichever it holds picks the recipe, and water on the side."
describe_machine_chemical_plant = "The fluids in its ports and the item loaded pick the product: plastic, sulfur, bitumen, mining fluid or rocket fuel."
describe_machine_wood_gasifier = "Logs in, wood gas out of its port, charcoal into the slot. Electric, no fuel slot."
describe_machine_electrolyser = "Two alumina to one aluminium plate, two quartz to one silicon. 500 kW while working."
describe_machine_core_sample_drill = "After 60 powered seconds it reports what lies under its column, once. Pick it up and place it again to sample anew."
describe_machine_launch_pad = "Parts and fuel are taken in ten stages over 60 powered seconds of assembly. Then the cargo leaves."
describe_machine_lab = "One slot per science pack. A set per unit of the queued technology."

