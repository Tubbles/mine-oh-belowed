catalogue_orbital_survey = "Orbital survey"
contract_control_boards = "Control boards"
mc_contract_control_boards = "The orbital station's control boards fail faster than procurement can blame the supplier. 300 circuits, contractor."
contract_station_girders = "Station girders"
mc_contract_station_girders = "The station is adding a docking arm nobody asked for. 200 steel. The arm is on the shareholders' slides already."
contract_plastic_quota = "Plastic quota"
mc_contract_plastic_quota = "Head office has a plastic quota to meet. 300 bars. What they are for is above your clearance and, frankly, ours."
contract_survey_fee = "Survey fee"
mc_contract_survey_fee = "The venture will point a satellite at the asset in exchange for 200 concrete and 100 iron plates. The satellite was idle anyway."
contract_lab_supplies = "Lab supplies"
mc_contract_lab_supplies = "The research division ran out of science packs and ideas. Send 400 packs. The ideas are not your problem."
contract_hull_plating = "Hull plating"
mc_contract_hull_plating = "A shuttle needs new hull plating. 300 aluminium plates. The previous plating was the lowest bid."
contract_brass_fittings = "Brass fittings"
mc_contract_brass_fittings = "Station plumbing. 300 brass plates and 100 pipes. Do not ask about the old fittings."
contract_wafer_stock = "Wafer stock"
mc_contract_wafer_stock = "The chip fab upstairs needs 200 silicon. Your silicon is cheaper than theirs, which is the point of you."
contract_station_expansion = "Station expansion"
mc_contract_station_expansion = "The station grows by a ring. 400 steel and 400 concrete. The ring has a name, it is on the invoice."
contract_research_consortium = "Research consortium"
mc_contract_research_consortium = "A consortium wants 300 science packs 2. In return the venture charts more of the asset for you. Everyone wins, some more."
contract_guidance_spares = "Guidance spares"
mc_contract_guidance_spares = "Other outposts keep losing rockets. 20 guidance units and 400 circuits. Yours arrive, which is noted."
