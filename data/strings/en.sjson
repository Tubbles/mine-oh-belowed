journal_rewards = "Reward:"
journal_messages = "Mission Control"
hint_chapters = "Chapters"
capsule_landed = "A capsule has landed"
objective_obtain = "Obtain"
objective_craft = "Make"
objective_place = "Place"
objective_sustain = "Sustain"
objective_research = "Research"
objective_deliver = "Deliver"
