contract_fulfilled_late = "Contract fulfilled late: {name}. The venture pays {value} percent, as the small print says."
free_trade_sold = "The venture bought the rest of the cargo for {value} credit. Market rates, less handling."
orbital_survey_charted = "Orbital survey complete: {value} veins charted around the pad. The satellite time is billed."
catalogue_ordered = "Ordered: {name}, {value} credit. The capsule leaves with the next drop."
catalogue_orbital_survey = "Orbital survey"
contract_control_boards = "Control boards"
mc_contract_control_boards = "The orbital station's control boards fail faster than procurement can blame the supplier. 300 circuits, contractor."
contract_station_girders = "Station girders"
mc_contract_station_girders = "The station is adding a docking arm nobody asked for. 200 steel. The arm is on the shareholders' slides already."
contract_plastic_quota = "Plastic quota"
mc_contract_plastic_quota = "Head office has a plastic quota to meet. 300 bars. What they are for is above your clearance and, frankly, ours."
contract_survey_fee = "Survey fee"
mc_contract_survey_fee = "The venture will point a satellite at the asset in exchange for 200 concrete and 100 iron plates. The satellite was idle anyway."
contract_lab_supplies = "Lab supplies"
mc_contract_lab_supplies = "The research division ran out of science packs and ideas. Send 400 packs. The ideas are not your problem."
contract_hull_plating = "Hull plating"
mc_contract_hull_plating = "A shuttle needs new hull plating. 300 aluminium plates. The previous plating was the lowest bid."
contract_brass_fittings = "Brass fittings"
mc_contract_brass_fittings = "Station plumbing. 300 brass plates and 100 pipes. Do not ask about the old fittings."
contract_wafer_stock = "Wafer stock"
mc_contract_wafer_stock = "The chip fab upstairs needs 200 silicon. Your silicon is cheaper than theirs, which is the point of you."
contract_station_expansion = "Station expansion"
mc_contract_station_expansion = "The station grows by a ring. 400 steel and 400 concrete. The ring has a name, it is on the invoice."
contract_research_consortium = "Research consortium"
mc_contract_research_consortium = "A consortium wants 300 science packs 2. In return the venture charts more of the asset for you. Everyone wins, some more."
contract_guidance_spares = "Guidance spares"
mc_contract_guidance_spares = "Other outposts keep losing rockets. 20 guidance units and 400 circuits. Yours arrive, which is noted."

// Notes (data/notes.sjson, work item 0070), the journal's Notes tab.
note_the_asset_title = "The asset"
note_the_asset_text = "The venture's filings call the planet the asset. It has no other name on record. Surface gravity is 0.97 g and the crust is ordinary silicate rock, which is exactly what made the lease cheap."
note_the_lease_title = "The lease"
note_the_lease_text = "The venture holds the exploitation lease for the whole asset: the surface, the strata and, pending a clause, the air above. You hold a contractor agreement with the venture. The difference is who pays for what, and the agreement is clear about it."
note_mission_control_title = "Mission Control"
note_mission_control_text = "Mission Control is the venture's orbital station, two hundred kilometres up and one invoice away. It hears everything you send and answers what it can bill. The voice is a shift of three people and a template."
note_the_contractor_title = "The contractor"
note_the_contractor_text = "Contractor agreement, clause 4: the contractor supplies labour, judgement and presence on the asset. The venture supplies the landing, the capsule and the invoices. Clause 9 describes the capsule as a loan."
note_the_capsule_title = "The drop capsule"
note_the_capsule_text = "The drop capsule came down with you and stays on the pad. Rewards land in it, deliveries leave from it, and it has no engine of its own. The venture's word for this arrangement is logistics."
note_iron_title = "Iron"
note_iron_text = "Hematite forms where iron dissolved in ancient water met oxygen and settled out as red oxide. On the asset it lies close to the surface almost everywhere, which is why iron veins turn up in every biome. Iron is the first thing the venture counts."
note_coal_title = "Coal"
note_coal_text = "Coal is buried swamp, pressed and heated for a very long time. The asset's coal lies under plains, hills, steppe and wetland, ground that was wet once and in places still is. Someone else's forests, billed by the lump."
note_copper_title = "Copper"
note_copper_text = "Chalcopyrite crystallises from hot fluids moving through fractured rock, and cassiterite often travels with it. That is why the copper veins give tin. The venture pays for neither separately."
note_strata_title = "Strata"
note_strata_text = "Topsoil, then stone, then deep stone: the asset is layered like any rocky world that once had water on it. An outcrop is where a vein breaks through to the surface, and the drills draw on the reservoir behind it. The lease counts the reservoir, not the outcrop."
note_the_survey_title = "The survey"
note_the_survey_text = "The venture bought the lease on a survey flown before anyone landed: spectrometry from orbit, gravity readings, a handful of probes. It found the outcrops and guessed the rest. The guesses were priced as facts."
note_the_ledger_title = "The ledger"
note_the_ledger_text = "Every reward is booked as an advance, every advance accrues interest, and every delivery is credited at a price the venture sets. The ledger has been open since your first hundred plates. You will not see it."
note_slag_title = "Slag"
note_slag_text = "Slag is the rock the ore came in, melted and set as glass. Every plate leaves some behind, and the lease is silent on where it goes. Heaps are what the outpost does to the asset, and the asset keeps them."
note_the_utility_title = "The utility"
note_the_utility_text = "Every kilowatt on the asset is generated on the asset. There is no grid to connect to and nobody to complain to. The venture's accounts list power as your cost and its capacity."
note_the_buyers_title = "The buyers"
note_the_buyers_text = "The buyers have never seen the asset. They are procurement desks on the station and on other outposts, and they buy by rate and by deadline. The venture sells them your output and a story about it."
note_the_station_title = "The station"
note_the_station_text = "The station holds forty people, a chip fab, a docking arm nobody asked for, and the buyers' agents. Everything it eats, breathes or builds comes up from surfaces like this one. The asset is one of several."
note_grade_title = "Grade"
note_grade_text = "A vein gives its best ore first. As the reservoir falls, more of what the drills bring up is low grade, up to sixty percent near the end. Every mine on every planet runs down this way. The venture's forecasts assume otherwise."
note_lead_and_zinc_title = "Lead and zinc"
note_lead_and_zinc_text = "Galena and sphalerite settle out of the same warm brines, so the lead veins carry zinc and the zinc veins carry lead. Geologists call it a Mississippi Valley type deposit. The asset has no Mississippi. The survey kept the name."
note_nickel_title = "Nickel"
note_nickel_text = "Pentlandite separates from cooling magma together with chalcopyrite, and the nickel veins show it. On Earth the richest of these deposits lie in an old impact crater. The survey has not ruled that out here."
note_extraction_rights_title = "Extraction rights"
note_extraction_rights_text = "Oil was not in the original lease. The venture bid for it separately and won, with your concrete and brass as collateral. The tar flats are now an asset within the asset."
note_tar_flats_title = "The tar flats"
note_tar_flats_text = "Tar flats form where oil seeps up through porous sand and its lighter fractions evaporate, leaving bitumen behind. The pits between are where the crude still rises. The survey found them from orbit by their colour."
note_the_flare_title = "The flare"
note_the_flare_text = "The flare stack burns what nobody buys. On a clear night it shows from orbit. The brochure uses daytime images."
note_deep_strata_title = "The deep strata"
note_deep_strata_text = "Forty to a hundred and twenty blocks down lie older, harder rocks and older veins, five times the size of the ones above them. They hold what the surface does not: bauxite, gold, quartz. The permit costs more than the drill."
note_bauxite_title = "Bauxite"
note_bauxite_text = "Bauxite is what tropical rain leaves of rock after millions of years of washing everything else away. Finding it deep under temperate ground means the asset was once much warmer. The venture was not interested in why."
note_gold_title = "Gold"
note_gold_text = "Gold travels in hot water and drops out where the water cools, usually into quartz. The caves show those veins in cross section. It is the one thing on the asset the venture would rather you did not count yourself."
note_previous_tenants_title = "The previous tenants"
note_previous_tenants_text = "Someone held a lease on the asset before the venture. They left crates in the caves, schematics inside, and no forwarding address. The venture's lawyers call the crates abandoned property and the schematics a windfall."
note_congealed_power_title = "Congealed power"
note_congealed_power_text = "Aluminium is common in rock and rare as metal, because freeing it takes so much electricity. Traders call it congealed power. Every plate the electrolyser makes is a few seconds of your grid, shipped to orbit."
note_launch_permit_title = "Launch permit"
note_launch_permit_text = "The regulator's permit covers one pad, one flight corridor and the cargo manifest. It does not cover what falls back down. Nothing is expected to."
note_from_orbit_title = "From orbit"
note_from_orbit_text = "The satellite that charted your veins was built for advertising and is rented by the hour. Its pass is six seconds on your map and a line on your invoice."
note_self_sufficient_title = "Self sufficient"
note_self_sufficient_text = "The venture has declared the outpost self sufficient, which means the outpost no longer needs the venture. The venture still needs the outpost. The contracts continue, and so does the lease."
