// Chapter 1, Arrival
chapter_01_title = "Arrival"
quest_arrival_title = "Arrival"
quest_arrival_text = "Touch down at the landing pad."
quest_bearings_title = "Get your bearings"
quest_bearings_text = "Look around and walk ten blocks."
quest_timber_title = "Timber"
quest_timber_text = "Obtain 10 logs from the trees near the pad."
quest_tools_title = "Tools of the trade"
quest_tools_text = "Craft 4 planks, then sticks, then a wooden pickaxe. The recipe browser lists what you can make."
quest_stone_title = "Stone"
quest_stone_text = "Mine 20 stone from boulders and exposed rock."
quest_rocks_title = "Read the rocks"
quest_rocks_text = "Find the iron outcrop and mine 10 hematite."
quest_furnace_title = "First furnace"
quest_furnace_text = "Craft a stone furnace from 5 stone and place it."
quest_fire_title = "Light the fire"
quest_fire_text = "Open the furnace, add fuel and hematite. Logs burn, coal burns better."
quest_stock_title = "Stock check"
quest_stock_text = "Obtain 10 iron plates."
mc_arrival = "Contractor. You have landed on schedule. The lease starts now, and so does the invoice."
mc_bearings_done = "Movement logged. The venture's insurers are relieved."
mc_timber = "Start with timber. It is the only thing on the asset that grows back."
mc_hint_grass = "Trees. The grass is not on the manifest."
mc_tools = "Hand tools are cheaper than hands. Craft accordingly."
mc_stone = "Stone next. The asset has plenty, and none of it is billable."
mc_rocks = "The survey marks an iron outcrop nearby. Red rock. Bring some back."
mc_rocks_done = "Hematite. The venture pays for plates, not rocks."
mc_furnace = "Plates require heat. Heat requires a furnace. The venture requires plates."
mc_smelting = "Smelting takes time. Time is billed."
mc_stock = "Ten plates will do for a start. The venture is patient, within reason."
mc_stock_done = "An advance against your first delivery. Interest applies."

// Chapter 2, The workshop
chapter_02_title = "The workshop"
quest_furnaces_title = "More heat"
quest_furnaces_text = "Place three stone furnaces."
quest_plates_title = "Plate stock"
quest_plates_text = "Obtain 50 iron plates."
quest_copper_title = "Copper"
quest_copper_text = "Smelt 10 copper plates from chalcopyrite."
quest_gears_title = "Gears"
quest_gears_text = "Craft 10 iron gears."
quest_drill_title = "The first drill"
quest_drill_text = "Craft a burner mining drill."
quest_storage_title = "Storage"
quest_storage_text = "Craft an iron chest and place it."
quest_survey_title = "Materials survey"
quest_survey_text = "Discover charcoal, glass and the electronic circuit."
quest_invoice_title = "The first invoice"
quest_invoice_text = "Deliver 100 iron plates to the capsule on the landing pad."
mc_furnaces = "One furnace is a hobby. Three is an operation."
mc_plates = "Output is now measured. Measurements are shared with shareholders."
mc_hint_fuel = "A machine that feeds machines exists. Consider it."
mc_hint_chests = "Chests. They hold things while you are elsewhere."
mc_copper = "Chalcopyrite. Copper for wire, and wire for everything the venture actually wants."
mc_gears = "Gears. Moving parts, fixed prices."
mc_drill = "Digging by hand does not scale. The venture has noticed."
mc_storage = "Inventory on the floor is inventory nobody can audit."
mc_survey = "Research and development is outsourced to you. Discover something."
mc_invoice = "The outpost's first invoice is due. One hundred iron plates, delivered to the capsule."
mc_invoice_done = "Delivery received and booked. Logistics parts are on their way, at cost."

// Chapter 3, Belts
chapter_03_title = "Belts"
quest_belt_parts_title = "Parts list"
quest_belt_parts_text = "Craft 4 belts and 1 burner inserter."
quest_connect_title = "Drill to furnace"
quest_connect_text = "Place a burner mining drill on the iron outcrop, belt its ore to a furnace and let a burner inserter feed the furnace. Then smelt 10 iron plates."
quest_coal_loop_title = "The coal loop"
quest_coal_loop_text = "Place a burner mining drill on a coal outcrop and loop some of its coal back into its own fuel slot with a belt and an inserter. Let the drills burn 10 coal."
quest_plate_line_title = "End of the line"
quest_plate_line_text = "Put a wooden chest at the end of a plate line, then let the furnaces smelt 50 iron plates."
quest_four_drills_title = "Four and three"
quest_four_drills_text = "Build up to 4 burner mining drills feeding 3 stone furnaces."
quest_prove_title = "Prove the outpost"
quest_prove_text = "Sustain 10 iron plates per minute for 10 minutes without touching anything."
mc_belt_parts = "The furnace goes cold whenever you walk away. The venture calls that downtime."
mc_connect = "Carrying ore by hand is a cost centre. Belts are a capital expense, which reads better."
mc_connect_done = "Ore to plate without a contractor in the loop. Management was briefly pleased."
mc_hint_dead_end = "A belt that ends nowhere is a shelf."
mc_hint_idle_inserter = "An inserter with nothing to pick is a decoration."
mc_coal_loop = "Every refuelling trip is billed as labour. Remove the trips."
mc_hint_drill_fuel = "The drill stopped for fuel again. It is standing on some."
mc_coal_loop_done = "A machine that buys its own fuel. The venture wishes it had more of those."
mc_plate_line = "Plates on the ground are a rounding error. Plates in a chest are an asset."
mc_four_drills = "One line proves a concept. Four drills prove a budget."
mc_prove = "Head office wants proof the outpost runs without you. Ten minutes, hands off. We are watching the numbers, not you."
mc_prove_done = "Automation verified. Power generation schematics attached. Their cost is on your account."

// Chapter 4, Power
chapter_04_title = "Power"
quest_steam_title = "Steam"
quest_steam_text = "Place an offshore pump at the water, a boiler fed by it and a steam engine fed by the boiler. The steam engine recipe came with the schematics."
quest_first_pole_title = "Wiring"
quest_first_pole_text = "Place 2 small poles to carry power from the engine. Then obtain 5 glass: smelt sand dug from a beach or a riverbed. Lamps will need it once optics is researched."
quest_first_research_title = "Science"
quest_first_research_text = "Place a lab within reach of a pole, feed it science packs and research automation."
quest_assembly_title = "Assembly"
quest_assembly_text = "Place an assembler, set it to iron gear wheels and let inserters feed it plates. Make 20 iron gear wheels."
quest_electric_drill_title = "Electric mining"
quest_electric_drill_text = "Research electric mining and place an electric mining drill where a burner drill used to be."
quest_second_engine_title = "Capacity"
quest_second_engine_text = "Place a second steam engine on the boiler's steam."
quest_first_contract_title = "The first contract"
quest_first_contract_text = "Deliver 100 electronic circuits to the capsule on the landing pad."
mc_steam = "The schematics are paid for. The interest is already running."
mc_steam_done = "Steam to shaft. The asset now has a utility bill."
mc_first_pole = "Power that stays in the engine is not billable. Poles carry it to where the invoices are."
mc_first_pole_done = "Glass. Sand with a markup. The lamp schematics are on the research list."
mc_first_research = "Research and development remains outsourced to you. Labs turn packs into schematics, the venture turns schematics into invoices."
mc_first_research_done = "Automation licensed. Assemblers do not take breaks, which head office finds refreshing."
mc_hint_brownout = "Demand exceeded supply. Machines slowed down. Nobody was harmed, which is not the point."
mc_hint_unpowered = "A machine outside every pole's reach is furniture."
mc_assembly = "An assembler makes gears while you make decisions. The venture only pays for one of those."
mc_electric_drill = "Burner drills eat coal and time. Electric drills eat power, which you now produce."
mc_electric_drill_done = "Coal saved is coal sold. Not by you."
mc_second_engine = "Demand grows faster than supply. That is the venture's business model, not yours. Add an engine."
mc_first_contract = "The venture has found a buyer for electronic circuits. One hundred, to the capsule. The contract carries your name."
mc_first_contract_done = "Contract fulfilled. Further contracts acquired by the venture, cost on your account. A crusher and a washer are enclosed. The low grade ore is already on its way."

// Chapter 5, Contracts
chapter_05_title = "Contracts"
quest_low_grade_title = "Low grade"
quest_low_grade_text = "Research steel processing, then ore processing. Obtain 20 low grade hematite from a drill on an iron vein that is running down."
quest_processing_line_title = "Crush and wash"
quest_processing_line_text = "Place a crusher and a washer with water. Crush low grade hematite into 50 crushed hematite and wash it back into ore the furnaces accept."
quest_slag_title = "Where it goes"
quest_slag_text = "Give slag somewhere to go: place 20 slag heaps, crush gravel in a crusher, make concrete in a washer and place 10 concrete blocks."
quest_alloys_title = "Alloys"
quest_alloys_text = "Make 40 bronze plates and 20 steel in alloy furnaces."
quest_recycling_title = "Overstock"
quest_recycling_text = "Research recycling, place a recycler and feed it 20 items the outpost made too many of."
quest_statistics_title = "Rates"
quest_statistics_text = "Sustain 30 iron plates per minute for 5 minutes. The production statistics show the rate."
quest_extraction_rights_title = "Extraction rights"
quest_extraction_rights_text = "Deliver 200 concrete and 100 brass plates to the capsule on the landing pad."
mc_low_grade = "The easy ore is spoken for. The veins now give low grade, and the venture still pays for plates, not rocks."
mc_low_grade_done = "Ore processing licensed. The licence fee was the easy part."
mc_processing_line = "Low grade ore is still ore after a crusher and a washer. The venture bought the lease on that assumption."
mc_processing_line_done = "Recovered ore. Head office calls it yield and has already spent it."
mc_slag = "Every plate leaves slag behind. The lease says nothing about heaps."
mc_hint_slag = "Slag does not vanish. Give it somewhere to go."
mc_slag_done = "Paving made from waste. The annual report will call it sustainability."
mc_alloys = "Plain metals sell. Alloys sell better. The margin stays upstairs."
mc_alloys_done = "Two alloys on the manifest. The buyers already ask for a third."
mc_recycling = "Overproduction is capital standing still. A recycler turns some of it back into parts, at a loss the venture has priced in."
mc_hint_recycler = "A full pocket is overstock. The recycler takes overstock."
mc_recycling_done = "A quarter back on every item. Head office has seen worse returns, mostly its own."
mc_statistics = "The buyer contracts for a rate, not a pile. Thirty iron plates a minute, five minutes running."
mc_hint_statistics = "The venture reads rates, not effort. So should you. Statistics: N, or the pause menu."
mc_statistics_done = "Rate held. The buyer has been told it was never in doubt."
mc_extraction_rights = "The venture is bidding for the asset's oil. Bids need collateral. Concrete and brass, to the capsule."
mc_extraction_rights_done = "The venture has acquired the extraction rights, cost on your account. Oil processing schematics attached, with steel and circuits for the refinery you will be asked to build."

// Chapter 6, Fluids
chapter_06_title = "Fluids"
quest_uphill_title = "Uphill"
quest_uphill_text = "Research fluid handling. Place a pump and a storage tank, and pump water up to where the outpost needs it."
quest_tar_title = "Tar"
quest_tar_text = "Place a tar pit pump on a tar pit in the tar flats and a refinery fed with its crude oil. Give every fraction its own pipe."
quest_fractions_title = "Fractions"
quest_fractions_text = "Refine 500 litres of petroleum gas and keep the fractions in storage tanks. Research cracking to turn the heavy fractions into lighter ones."
quest_flare_title = "Flare"
quest_flare_text = "Place a flare stack on the gas line. It burns only what nothing else takes, so the refinery never stops for a full pipe."
quest_plastic_title = "Plastic"
quest_plastic_text = "Research plastics, place a chemical plant and make 50 plastic bars from petroleum gas and coal."
quest_two_routes_title = "Two routes"
quest_two_routes_text = "Research renewable plastics, place a wood gasifier and make 20 more plastic bars, from wood gas and charcoal in a chemical plant."
quest_waste_power_title = "Waste power"
quest_waste_power_text = "Research combustion power, place a combustion generator on the gas line and let it burn 300 litres of gas."
quest_deep_mining_permit_title = "Deep mining permit"
quest_deep_mining_permit_text = "Deliver 200 plastic bars and 50 sulfur to the capsule on the landing pad."
mc_uphill = "Water runs downhill. The outpost does not always stand downhill. The venture declines to relocate it."
mc_uphill_done = "Water where it was not. Pumping is billed by the kilowatt."
mc_tar = "The extraction rights cover the tar flats. The tar is now an asset. Pump it."
mc_hint_mixing = "Two fluids, one pipe. The pipe declined."
mc_tar_done = "Crude oil in, three fractions out. The venture priced one of them."
mc_fractions = "Gas, light oil, heavy oil. The buyers want the gas. The rest waits in tanks until someone wants it."
mc_fractions_done = "Cracking licensed. Heavy oil becomes light oil becomes gas. The margin moves the same way."
mc_flare = "A refinery with nowhere to put its gas stops. A stopped refinery bills nothing. A flare stack costs less than a stop."
mc_hint_flare = "Burning gas to make nothing. The venture calls that a rounding error."
mc_flare_done = "The asset has a flame on its skyline. The brochure will crop it."
mc_plastic = "Plastic is what the buyers actually want. Gas and coal in, bars out."
mc_plastic_done = "Plastic on the manifest. The venture has already sold it twice."
mc_two_routes = "Oil runs out. Trees grow back, slowly. The venture hedges both ways and bills you for the hedge."
mc_two_routes_done = "Two routes to one bar. Head office will pick whichever is cheaper this quarter."
mc_waste_power = "Gas in a flare is money in the air. Gas in a generator is money in the grid."
mc_waste_power_done = "Waste gas now appears on the power bill as a credit. Accounting is confused, and pleased."
mc_deep_mining_permit = "The surface veins will not outlast the lease. The venture is applying for the deep strata, and the regulator accepts plastic and sulfur."
mc_deep_mining_permit_done = "Permit granted for the deep strata, cost on your account. The bore drill is cleared for assembly. Steel and circuits enclosed."

// Chapter 7, Scale
chapter_07_title = "Scale"
quest_second_vein_title = "Second vein"
quest_second_vein_text = "Research prospecting and assay 2 veins. Place 4 electric mining drills in all and bring a second vein into the base."
quest_deep_permit_title = "Deep permit"
quest_deep_permit_text = "Research logistics, logistics science and electrolysis. Take a core sample, place a bore drill over a deep vein and draw 200 units from it."
quest_aluminium_title = "Aluminium"
quest_aluminium_text = "Make 50 aluminium plates and 20 silicon in electrolysers."
quest_two_floors_title = "Two floors"
quest_two_floors_text = "Build the factory upwards. Place 10 belt lifts and 20 concrete blocks for the upper floor."
quest_hydro_title = "Hydro"
quest_hydro_text = "Research hydro power, place a hydro turbine in flowing water and let it generate 10 MJ."
quest_grid_title = "Grid"
quest_grid_text = "Research the electric grid and place a substation."
quest_schematic_title = "Schematic"
quest_schematic_text = "Find a schematic in a crate in the caves."
quest_sixty_title = "Sixty"
quest_sixty_text = "Sustain 60 iron plates per minute for 5 minutes."
quest_launch_pad_permit_title = "Launch pad permit"
quest_launch_pad_permit_text = "Deliver 100 aluminium plates and 50 silicon to the capsule on the landing pad."
mc_second_vein = "One vein feeds an outpost. The venture has promised the buyers a base. Find another."
mc_second_vein_done = "Two veins on the ledger. The venture reports it to the board as growth."
mc_deep_permit = "The permit covers the deep strata. It does not cover finding them. Sample first, drill second."
mc_hint_bore_drill_no_vein = "The drill needs a vein below it. The venture needs a contractor who checks."
mc_deep_permit_done = "Ore from the deep strata, on the surface. The regulator has been sent a photograph."
mc_aluminium = "Bauxite is worth little. Aluminium is worth a great deal. The difference is electricity, which you supply."
mc_aluminium_done = "Aluminium and silicon on the manifest. Both are light. The invoice is not."
mc_two_floors = "Land on the asset is leased by the square metre. Air above it is not, yet."
mc_two_floors_done = "A second floor. Legal is drafting a clause for the air."
mc_hydro = "Water flows downhill for free. The venture has noticed."
mc_hint_turbine_still_water = "A turbine in still water is a sculpture."
mc_hydro_done = "Power from the river. The river has not been invoiced. Legal is looking into it."
mc_grid = "The outpost has outgrown its poles. Substations carry more power further, and cost more to match."
mc_grid_done = "One grid for the whole base. One outage for the whole base, too."
mc_schematic = "The previous tenants left crates in the caves. The venture considers their contents abandoned property."
mc_hint_seismic = "The seismic charge found rock. The venture found the invoice."
mc_schematic_done = "Schematic recovered. The previous tenants will not be credited."
mc_sixty = "The buyer now contracts for a plate a second. Five minutes running, no excuses on file."
mc_sixty_done = "Rate held. The buyer has asked for more. The venture has said yes on your behalf."
mc_launch_pad_permit = "The venture wants the asset's output in orbit. Launch pads need a permit, and the regulator wants aluminium and silicon."
mc_launch_pad_permit_done = "Launch pad permit granted. The venture has filed the flight plan, the fuel is on your account. Steel and plastic enclosed for the pad."

// Chapter 8, Rocket program
chapter_08_title = "Rocket program"
quest_rocketry_title = "Rocketry"
quest_rocketry_text = "Research rocketry."
quest_launch_pad_title = "Launch pad"
quest_launch_pad_text = "Place a launch pad."
quest_rocket_parts_title = "Rocket parts"
quest_rocket_parts_text = "Make 10 rocket structures, 2 guidance units and a cargo capsule."
quest_first_launch_title = "First launch"
quest_first_launch_text = "Load the parts and rocket fuel into the launch pad, assemble the rocket, load cargo and launch it."
quest_contract_title = "Contract"
quest_contract_text = "Fulfil a contract from the launch pad's Contracts tab."
quest_orbital_survey_title = "Orbital survey"
quest_orbital_survey_text = "Buy an orbital survey from the launch pad's Catalogue tab."
quest_productivity_title = "Productivity"
quest_productivity_text = "Research a level of mining productivity."
quest_self_sufficient_title = "Self sufficient"
quest_self_sufficient_text = "Ship 1000 items in total."
mc_rocketry = "The permit covers the pad. The rocket is your problem. Head office recommends it be one that flies."
mc_rocketry_done = "Rocketry on file. The insurers have been informed and have raised the premium."
mc_launch_pad = "The pad goes where the asset is flattest. The venture has no preference, as long as it is on the lease."
mc_launch_pad_done = "Pad in place. The regulator has been sent a photograph of it, from a flattering angle."
mc_rocket_parts = "One rocket, in parts. The venture buys nothing it can bill you for making."
mc_rocket_parts_done = "Parts for one rocket. Head office asks that it be used only once."
mc_first_launch = "The buyers are in orbit. The cargo is on the asset. The difference is a launch."
mc_hint_launch_parts_missing = "The pad is waiting on parts. So is the venture."
mc_hint_launch_cargo_empty = "An empty rocket is a very expensive firework. The buyers ordered cargo."
mc_first_launch_done = "First shipment in orbit. The venture has told the shareholders it was routine."
mc_contract = "The buyers post contracts. The venture accepts them on your behalf and keeps the margin."
mc_contract_done = "Contract fulfilled. The buyer called it adequate, which counts as praise in orbit."
mc_orbital_survey = "The venture rents satellite time by the hour. The asset looks better from orbit, on paper."
mc_orbital_survey_done = "Survey delivered. The satellite has been returned to the advertising contract it was on."
mc_productivity = "The drills can give more. The venture expects them to, every quarter."
mc_productivity_done = "Output up. Next quarter's target has been adjusted to match."
mc_self_sufficient = "Head office reviews the outpost when the manifests reach a thousand items shipped. Keep them coming."
mc_self_sufficient_done = "The venture declares the outpost self sufficient and thanks you for your service, contractor. The contracts continue."

