// Game wide settings, loaded at startup (work items 0001 and 0008).
name = "Mine oh Belowed"
tick_rate = 60
// Length of one cosmetic day and night cycle.
day_length_seconds = 1200
// Items every player starts with, by item id from items.sjson. Torches
// have no recipe yet; machines are crafted by hand (work item 0012).
starting_items = [
	{item = "torch", count = 64}
]
// World setting "all recipes unlocked at start", for repeat playthroughs:
// every technology counts as researched and every item as discovered.
// The --unlock-all command line flag does the same.
all_recipes_unlocked = false
// World setting "vein finiteness": false keeps veins finite (the default),
// so drills drain them and an exhausted outcrop turns to spent rock; true
// lets drills draw from every vein forever.
veins_infinite = false
// Minutes a loose item (a stack spilled by mining or a pickup that did
// not fit, dropped from the inventory, or fallen off a belt end) lies on
// the ground before it vanishes; 0 keeps loose items forever.
loose_item_despawn_minutes = 15
// The terrain field's level of detail (work item 0169): a part of the
// field nearer the camera than the first distance is meshed at full
// resolution, nearer than the second at half, the third at a quarter, the
// fourth at an eighth; beyond the fourth only the globe is drawn. Rising,
// in metres, at most 4096. The planet preview (--planet-preview) streams
// field chunks within the first.
field_view = {
	level_distances_metres = [64, 160, 384, 1024]
}
