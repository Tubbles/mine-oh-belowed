// Game wide settings, loaded at startup (work items 0001 and 0008).
name = "Mine oh Belowed"
tick_rate = 60
// Length of one cosmetic day and night cycle.
day_length_seconds = 1200
// Items every player starts with, by item id from items.sjson, the first
// and every joining one (work item 0179): wooden foundations start a pad
// (work item 0196), torches light a dug cave. No digging tool (work item
// 0265): the first logs come from a small tree felled by hand (0197) and
// make the wooden shovel and pickaxe and the stone cutting table, and the
// toolbar starts on slot 1, the foundations, so a resting thumb digs
// nothing. Each kind is named on the next toolbar slot in order (work
// item 0278). More torches are made by hand from a coal and a stone
// (0179); machines are crafted by hand (work item 0012).
starting_items = [
	{item = "wooden_foundation", count = 16}
	{item = "torch", count = 4}
]
// The water tech demo's toolbar (work item 0291): one entry per slot in
// order. Dirt is one full stack since the demo never debits it; the water
// bucket, the drain bucket and ten pumps (work item 0295) come before the
// torch.
tech_demo_items = [
	{item = "iron_pickaxe", count = 1}
	{item = "dirt", count = 50}
	{item = "water_bucket", count = 1}
	{item = "drain_bucket", count = 1}
	{item = "water_pump", count = 10}
	{item = "torch", count = 20}
]
// The toolbars stacked on the HUD (work item 0278, doc/content.md): 1 to 4.
toolbars = 1
// World setting "all recipes unlocked at start", for repeat playthroughs:
// every technology counts as researched and every item as discovered.
// The --unlock-all command line flag does the same.
all_recipes_unlocked = false
// World setting "vein finiteness": false keeps veins finite (the default),
// so drills drain them and an exhausted outcrop turns to spent rock; true
// lets drills draw from every vein forever.
veins_infinite = false
// Minutes a loose item (a stack spilled by mining or a pickup that did
// not fit, dropped from the inventory, or fallen off a belt end) lies on
// the ground before it vanishes; 0 keeps loose items forever.
loose_item_despawn_minutes = 15
// The terrain field's level of detail (work item 0169): a part of the
// field nearer the camera than the first distance is meshed at full
// resolution, nearer than the second at half, the third at a quarter, the
// fourth at an eighth; beyond the fourth only the globe is drawn. Rising,
// in metres, at most 4096. The planet preview (--planet-preview) streams
// field chunks within the first. The View distance setting packs these
// levels inside a shorter view (work item 0343), so the first distance
// must fit the least view distance, 256 m, together with the gaps.
field_view = {
	level_distances_metres = [64, 160, 384, 1024]
}
// The trees' draw (work item 0310, doc/presentation.md, The field
// session), a row for the desktop builds and one for Android: a model
// each for the trees within near_metres (16 to 256), at most near_limit
// (1 to 8192) of them nearest first, crossfaded with their cards over
// fade_metres (1 to half the near distance); cards out to far_metres (the
// near distance to field_view's last distance), at most far_limit (0 to
// 1000000, 0 draws none) of them by tiles nearest first, fading out over
// the last far_fade_metres (1 to a quarter of the far distance). The
// Steam Deck takes the desktop row.
field_trees = {
	desktop = {near_metres = 96, near_limit = 1024, far_metres = 1024, far_limit = 160000, fade_metres = 12, far_fade_metres = 64}
	android = {near_metres = 96, near_limit = 1024, far_metres = 512, far_limit = 40000, fade_metres = 12, far_fade_metres = 64}
}
// The ground cover's draw (work item 0311, doc/presentation.md, The field
// session), a row for the desktop builds and one for Android: each kind's
// reach (data/planets.sjson, cover) times distance_percent (10 to 200),
// clamped 8 m inside field_view's first distance; the instances kept by
// their rank under density_percent (0 to 100, 0 turns the cover off); a
// kind's instances in a node at most node_limit (64 to 65536), the lowest
// ranks kept. The Steam Deck takes the desktop row.
field_cover = {
	desktop = {distance_percent = 100, density_percent = 100, node_limit = 8192}
	android = {distance_percent = 60, density_percent = 45, node_limit = 4096}
}
// The sun's shadow (work item 0328, doc/presentation.md, Light on the
// field): strength_percent (0 to 100) of the sun's light a full shadow
// takes away; a row for the desktop builds (the Steam Deck's too) and one
// for Android: on, the default of settings.sun_shadows; map_texels (512,
// 1024, 2048 or 4096) a side of the depth map; radius_metres (16 to 256)
// round the eye that receives the shadow, fading out over its last
// quarter; caster_reach_metres (0 to field_view's last distance) beyond
// it towards the sun that still casts; tree_limit (0 to 16384, 0 for
// none) of the trees that cast, nearest the eye first.
sun_shadows = {
	strength_percent = 70
	desktop = {on = true, map_texels = 2048, radius_metres = 64, caster_reach_metres = 96, tree_limit = 2048}
	android = {on = false, map_texels = 1024, radius_metres = 48, caster_reach_metres = 64, tree_limit = 512}
}
// The player on the terrain field (work item 0170, doc/content.md, World):
// lengths in millimetres, speeds in millimetres per second, gravity from
// the planet record. Ground steeper than the walkable angle slows the walk
// and slides the player down at up to the slide speed; a ledge of the step
// height (in samples of the world's spacing) is walked over, a jump rises
// the jump height, and Jump while walking into a ledge up to the mantle
// height lifts onto it. Sneak on foot crouches to the crouch height (0218).
field_player = {
	capsule_radius_millimetres = 300
	capsule_height_millimetres = 1800
	eye_height_millimetres = 1600
	crouch_height_millimetres = 850
	crouch_eye_height_millimetres = 700
	walkable_angle_degrees = 60
	slide_speed_millimetres_per_second = 6000
	step_height_samples = 1
	jump_height_millimetres = 1100
	mantle_height_millimetres = 1500
	tool_reach_millimetres = 6000
	walk_speed_millimetres_per_second = 4300
	sprint_speed_millimetres_per_second = 5600
	sneak_speed_millimetres_per_second = 1300
	fall_speed_limit_millimetres_per_second = 50000
	fly_speed_millimetres_per_second = 12000
	fly_sprint_speed_millimetres_per_second = 36000
	// The jetpack and the cheat movement (0296, doc/content.md): 90 ticks of thrust at 20 m/s² capped at 9 m/s up, 2 ticks back per tick on the ground; the cheat multiplies the speeds by 4, the jump height and the jet by 3.
	jetpack_acceleration_millimetres_per_second_squared = 20000
	jetpack_budget_ticks = 90
	jetpack_refill_ticks_per_tick = 2
	jet_speed_limit_millimetres_per_second = 9000
	cheat_speed_factor = 4
	cheat_jump_factor = 3
	cheat_jet_factor = 3
}
// The hand tool's brushes on the terrain field (work item 0171,
// doc/content.md, Brushes). Each tick a brush is held, every sample within
// the radius of the hit changes by the rate, in density steps (128 a
// sample spacing, 127 the full ground of a sample): a dig lowers the
// samples towards air, a place raises them towards ground from the held
// material. A sphere works round the hit; level flattens to the plane
// through the hit across the player's up. The brush key cycles them.
field_brushes = [
	{id = "small", shape = "sphere", radius_millimetres = 1000, rate_density_steps_per_tick = 6}
	{id = "large", shape = "sphere", radius_millimetres = 2000, rate_density_steps_per_tick = 3}
	{id = "level", shape = "level", radius_millimetres = 2000, rate_density_steps_per_tick = 6}
]
// The water field (work item 0172, doc/content.md, Field water): fill in
// 1/254 of a sample. Each tick an awake sample moves at most
// fill_rate_per_tick to each neighbour, down first, then levelling with
// its equals; a sample whose fill did not change for still_ticks_to_sleep
// ticks sleeps until a neighbour changes; fill at or below minimum_fill on
// dry ground stops moving and drops by one every dry_ticks_per_step ticks.
// A spring (work item 0367) pours at most spring_fill_per_tick fill a tick
// (1 to 254; 64 is the link rate, about 15 cubic metres a second at 1 m
// spacing): it refills by that much up to full, and a spring under a lake
// or the sea pours that much into it.
// The pressure pull (work item 0292): with pressure on, a not-full sample
// on full water that moved nothing searches the full body under it, at
// most pressure_visit_budget samples a search and
// pressure_visit_budget_per_tick a tick, for the highest surface and takes
// its share from there in one step (communicating vessels). minimum_head
// is the dead band in fill (4 is about 1/64 of a sample): a level
// difference at or under it moves nothing except into a cell entirely
// below, so a settled lake is still.
// The water bodies (work item 0293), read only under the bodies model of
// the tech demo: a body over its sill hands weir_rate_per_head fill a tick
// per sample of head to its spill (51 is about 200 litres a cell of head
// at 1 m), between weir_floor and weir_cap fill a tick, and nothing while
// it stands weir_dead_band fill or less over the sill's volume (8 is 1/32
// sample); a flood visits flood_visit_budget samples a tick at most and
// rises flood_rise_samples samples above its floor at most.
// The demo's buckets (work item 0295): a press pours or takes
// bucket_fill_per_press fill (1 to 16256; 254 is one sample, a cubic metre
// at 1 m spacing) over the brush round the aimed sample, nearest first,
// and a held Place does it again every bucket_repeat_ticks ticks (1 to
// 255; 6 is ten times a second).
// The offshore pump on a field frame (work item 0376, doc/fluids.md): the
// water within 2 m under its intake cell's centre. A pump with water
// keeps running while it holds offshore_pump_keep_depth_millimetres; one
// without, and a placement, need offshore_pump_start_depth_millimetres.
// Each 1 to 2000, the start at least the keep, so a surface waving at
// one of them does not switch the pump every tick.
field_water = {
	fill_rate_per_tick = 64
	spring_fill_per_tick = 64
	still_ticks_to_sleep = 20
	minimum_fill = 8
	dry_ticks_per_step = 60
	pressure = true
	pressure_visit_budget = 128
	pressure_visit_budget_per_tick = 20000
	minimum_head = 4
	weir_rate_per_head = 51
	weir_cap = 63
	weir_floor = 15
	weir_dead_band = 8
	flood_visit_budget = 4000
	flood_rise_samples = 64
	bucket_fill_per_press = 254
	bucket_repeat_ticks = 6
	offshore_pump_keep_depth_millimetres = 500
	offshore_pump_start_depth_millimetres = 750
}
// The chunks every machine of a session simulates: this many chunks
// around each player's chunk across and up and down (work item 0177).
// Loading, the tick and the state hash all follow it.
simulated_chunk_radius_horizontal = 6
simulated_chunk_radius_vertical = 3
// The cell of a foundation frame in millimetres, from 250 to 2000 (work
// item 0174, doc/content.md, Foundations): a foundation is one cell thick
// and machines stand on its cells.
foundation_pitch_millimetres = 500
// The blocks a held foundation places at once (work item 0193,
// doc/content.md, Foundations): a square of size by size cells and height
// cells high, chosen in the configure pop-up (work item 0202), which
// Context_Action opens on a foundation highlighted in the inventory view;
// the first of each list is a new player's. Each from 1 to 16 (at most
// 4096 cells a block), at most 16 entries.
foundation_sizes = [1, 2, 5, 10]
foundation_heights = [1, 2, 5]
// The largest footprint Place puts down in one press while the placement
// editor is on (work item 0215, doc/content.md, Foundations): a held
// machine (or a foundation's block: size, size and height) whose footprint
// is wider, deeper or higher goes through the editor's outline and anchor.
// Each 1 to 16.
direct_placement_limit = {width = 2, depth = 2, height = 3}
// Free belt and pipe runs between poles (work item 0176, doc/content.md,
// Belt poles and runs): a run either inclines (its ends more than the
// level tolerance apart in height, its facings aligned) or turns (level,
// its facings turning up to the maximum), never both, and spans at most
// the maximum. The slope holds along the whole belt, not only the chord.
// An incline's facings and chord may turn up to aligned_degrees: at least
// half the 15 degree yaw step a new free pole is off the chord by, plus
// one. Span 1000 to 100000, slope 1 to 100, turn 15 to 135, tolerance 0
// to 1000, aligned 8 to 30.
belt_runs = {
	maximum_span_millimetres = 30000
	maximum_slope_percent = 70
	maximum_turn_degrees = 90
	level_tolerance_millimetres = 250
	aligned_degrees = 8
}
// Machines on bare ground (work item 0201, doc/content.md, Machines on
// bare ground): Place with a machine aimed at bare ground stands it on a
// frame of its own when the ground under its footprint's corners and
// centre lies within bare_ground_flatness_millimetres (0 to 2000) and
// refuses it as too steep otherwise. A machine whose bottom cells do not
// all stand on foundations breaks down after bare_ground_life_minutes (1
// to 10080) of operation; a record's own bare_ground_life_minutes
// overrides it. A worn or broken machine torn down returns
// salvage_percent (1 to 100) of the inputs of the hand recipe making it,
// rounded down. A record with stands_on_ground (poles, pipes, belts, the
// belt pole, the pod) never wears and is never refused for slope.
bare_ground_flatness_millimetres = 250
bare_ground_life_minutes = 60
salvage_percent = 80
// The arrival (work items 0200, 0269, doc/content.md, The arrival): a
// new world's first arrival_ticks (0 for no fall, else up to 3600 and
// more than the settle ticks) are the pod's fall, the players strapped
// into the pod's chair, the look free; at the last one it lands, the
// hatches closed (the airlock opens them as a player comes,
// pod_airlock). The hit comes arrival_settle_ticks (0 to 300) before
// that. The fall is an atmospheric entry: the pod leaves
// arrival_start_metres (20 to 4096, at least 128 m, the deepest relief
// a planet may have, above atmosphere's top_metres) above the crater's
// floor at
// arrival_entry_speed_metres_per_second (1 to 1000),
// arrival_entry_angle_degrees (5 to 85) below the horizontal towards
// its chair's facing. Gravity and a drag of the air's density times the
// speed squared, arrival_terminal_speed_metres_per_second (1 to 1000)
// the terminal speed at density 1, bend the path towards vertical. The
// curve is integrated once in its own seconds and stretched over the
// descent: its last arrival_real_seconds (1 to 60, below the curve's
// seconds and the descent's) play 1:1 at the end, the natural time
// before them is stretched over the rest, so the seconds tune the tempo
// and the keys the shape. The pod rests leaning
// arrival_rest_tilt_degrees (0 to 25) from the planet's up towards its
// travel, about its door's axis. The heating is the density times the
// speed cubed over its peak; below arrival_heat_threshold_percent (0 to
// 90) of the peak nothing glows, and the hit must lie below it. The
// start lies inside 0.9 of field_view.level_distances_metres' last
// entry from the crater. At the hit arrival_debris_pieces (0 to 400)
// clods fly out of the crater on arcs leaving at
// arrival_debris_angle_degrees (30 to 60) above the horizontal, the inner
// ones fastest and farthest, none beyond five crater radii; they rest
// for up to arrival_debris_rest_seconds (0 to 900) and sink away
// (presentation only). During the heating arrival_flakes_per_second (0
// to 160) flakes break off the heat shield's rim at the peak, fewer by
// the heat's square below it, and drift aft through the wake
// (presentation only).
// The atmosphere's density falls as exp(-altitude / scale_height_metres)
// (1 to 4096) and is 0 above top_metres (64 to 4096); top_metres less two
// scale heights stays at least 64 m: the sky is black with stars above
// the top, the day's from two scale heights under it.
arrival_ticks = 1860
arrival_settle_ticks = 60
arrival_start_metres = 810
arrival_entry_angle_degrees = 45
arrival_entry_speed_metres_per_second = 75
arrival_terminal_speed_metres_per_second = 20
arrival_heat_threshold_percent = 20
arrival_real_seconds = 6
arrival_debris_pieces = 160
arrival_debris_rest_seconds = 150
arrival_debris_angle_degrees = 45
arrival_flakes_per_second = 90
arrival_rest_tilt_degrees = 15
atmosphere = {
	top_metres = 650
	scale_height_metres = 145
}
// The entry's plasma on the pod (0273, 0304): its colours are Kerbal
// Space Program's reentry (0305). haze_color is the air's glow (red, the
// wake where its light is faint), ablator_color the heat shield's
// (orange, its rim and the wake's bright body), core_color the hottest
// (yellow white, the shield's face, the sparks and the flakes' rims), 0
// to 255 per channel, never black; the heat drives the wake's opacity
// and its place between them, never their hue. soot_percent (0 to 60)
// is the soot's opacity at the glass's rim once the heating is over,
// kept after the landing. wake_opacity_percent (5 to 95) is the wake's
// opacity face on where the chair's porthole looks at the peak; lower
// shows the pod through its flames from outside and the sky through the
// porthole.
arrival_plasma = {
	haze_color = [255, 28, 6]
	ablator_color = [255, 92, 30]
	core_color = [255, 248, 150]
	soot_percent = 35
	wake_opacity_percent = 60
}
// The pod's airlock (work items 0222, 0231, doc/content.md, Hatches): a
// hatch of the pod is open exactly while some player's capsule, standing
// or crouched, comes within reach_millimetres (50 to 300) of its cells.
// The reach stays under half the airlock's 1 m less the crouched
// capsule's 0.6 m, so both hatches are shut round a player in the middle.
pod_airlock = {
	reach_millimetres = 150
}
// The field session (work item 0179, doc/content.md, World): every
// machine simulates the terrain field's chunks within chunk_radius chunks
// of each player's chunk on each axis (a chunk is 32 samples, 32 m at
// 1000 mm and 10.7 m at 333 mm), and keeps the chunks it held within
// chunk_margin more, so a player walking along a chunk border does not
// unload and reload a slab each step. Radius 1 to 3, margin 0 to 2. Place
// with the torch item puts the torch emitter of data/lighting.sjson at
// the air in front of the targeted ground. pad_foundation (work item
// 0196) is the foundation of the benchmark's pad; it must name a machine
// of kind foundation.
field_simulation = {
	chunk_radius = 2
	chunk_margin = 1
	torch_item = "torch"
	torch_emitter = "torch"
	pad_foundation = "wooden_foundation"
}
// The sun and the torchlight on the field (0297, 0313,
// doc/presentation.md, Light on the field): sun_strength_percent (0 to
// 400) scales the sun's light, whose colour runs from sun_high_color
// with the sun high to sun_low_color on the horizon (0 to 255 per
// channel, neither black); sky_light_percent (0 to 400) is the sky's
// light on an upward face in percent of the dome's colours, and
// ground_bounce_percent (0 to 100) the light the ground throws back up
// in percent of the light it takes. The torchlight's brightness in
// percent of TORCHLIGHT_COLOR, its cone's full and outer half angles in
// degrees (outer above inner) and its reach in metres.
sun_and_torchlight = {
	sun_strength_percent = 100
	sun_high_color = [255, 243, 222]
	sun_low_color = [255, 150, 72]
	sky_light_percent = 60
	ground_bounce_percent = 60
	torchlight_strength_percent = 100
	torchlight_inner_cone_degrees = 28
	torchlight_outer_cone_degrees = 36
	torchlight_range_metres = 40
}
// The aerial haze on the field (0313, doc/presentation.md, Light on the
// field): metres (100 to 1000000) is the distance over which air at the
// planet's radius takes 63 percent of the sky's horizon colour; the air
// thins with height as the atmosphere's does. sun_glow_percent (0 to
// 100) warms the haze and the sky towards a low sun, in percent of
// sun_low_color.
haze = {
	metres = 1500
	sun_glow_percent = 50
}
// The water's look (0294, doc/presentation.md, The water's look): the
// surface wave layer, presentation only, never in the simulation or the
// hash. waves turns it off; the others are percents: the wave equation's
// c²dt²/dx² (1 to 50, 50 is the stability limit), the damping a tick (50
// to 99; 100 would never rest), the height clamp in percent of a sample
// (1 to 50) and the kick a full sample of arriving water gives the
// velocity (1 to 100, in percent of a sample a tick).
water_look = {
	waves = true
	wave_speed_percent = 25
	wave_damping_percent = 98
	wave_clamp_percent = 15
	wave_kick_percent = 20
}
