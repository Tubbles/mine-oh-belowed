// Game wide settings, loaded at startup (work items 0001 and 0008).
name = "Mine oh Belowed"
tick_rate = 60
// Length of one cosmetic day and night cycle.
day_length_seconds = 1200
// Items every player starts with, by item id from items.sjson, the first
// and every joining one (work item 0179): a stone pickaxe digs stone,
// foundations start a pad, torches light a dug cave. More torches are
// made by hand from a coal and a stone (0179); machines are crafted by
// hand (work item 0012).
starting_items = [
	{item = "stone_pickaxe", count = 1}
	{item = "foundation", count = 16}
	{item = "torch", count = 4}
]
// World setting "all recipes unlocked at start", for repeat playthroughs:
// every technology counts as researched and every item as discovered.
// The --unlock-all command line flag does the same.
all_recipes_unlocked = false
// World setting "vein finiteness": false keeps veins finite (the default),
// so drills drain them and an exhausted outcrop turns to spent rock; true
// lets drills draw from every vein forever.
veins_infinite = false
// Minutes a loose item (a stack spilled by mining or a pickup that did
// not fit, dropped from the inventory, or fallen off a belt end) lies on
// the ground before it vanishes; 0 keeps loose items forever.
loose_item_despawn_minutes = 15
// The terrain field's level of detail (work item 0169): a part of the
// field nearer the camera than the first distance is meshed at full
// resolution, nearer than the second at half, the third at a quarter, the
// fourth at an eighth; beyond the fourth only the globe is drawn. Rising,
// in metres, at most 4096. The planet preview (--planet-preview) streams
// field chunks within the first.
field_view = {
	level_distances_metres = [64, 160, 384, 1024]
}
// The player on the terrain field (work item 0170, doc/content.md, World):
// lengths in millimetres, speeds in millimetres per second, gravity from
// the planet record. Ground steeper than the walkable angle slows the walk
// and slides the player down at up to the slide speed; a ledge of the step
// height (in samples of the world's spacing) is walked over, a jump rises
// the jump height, and Jump while walking into a ledge up to the mantle
// height lifts onto it.
field_player = {
	capsule_radius_millimetres = 300
	capsule_height_millimetres = 1800
	eye_height_millimetres = 1600
	walkable_angle_degrees = 40
	slide_speed_millimetres_per_second = 6000
	step_height_samples = 1
	jump_height_millimetres = 1100
	mantle_height_millimetres = 1500
	tool_reach_millimetres = 4000
	walk_speed_millimetres_per_second = 4300
	sprint_speed_millimetres_per_second = 5600
	sneak_speed_millimetres_per_second = 1300
	fall_speed_limit_millimetres_per_second = 50000
	fly_speed_millimetres_per_second = 12000
	fly_sprint_speed_millimetres_per_second = 36000
}
// The hand tool's brushes on the terrain field (work item 0171,
// doc/content.md, Brushes). Each tick a brush is held, every sample within
// the radius of the hit changes by the rate, in density steps (128 a
// sample spacing, 127 the full ground of a sample): a dig lowers the
// samples towards air, a place raises them towards ground from the held
// material. A sphere works round the hit; level flattens to the plane
// through the hit across the player's up. The brush key cycles them.
field_brushes = [
	{id = "small", shape = "sphere", radius_millimetres = 1000, rate_density_steps_per_tick = 6}
	{id = "large", shape = "sphere", radius_millimetres = 2000, rate_density_steps_per_tick = 3}
	{id = "level", shape = "level", radius_millimetres = 2000, rate_density_steps_per_tick = 6}
]
// The water field (work item 0172, doc/content.md, Field water): fill in
// 1/254 of a sample. Each tick an awake sample moves at most
// fill_rate_per_tick to each neighbour, down first, then levelling with
// its equals; a sample whose fill did not change for still_ticks_to_sleep
// ticks sleeps until a neighbour changes; fill at or below minimum_fill on
// dry ground stops moving and drops by one every dry_ticks_per_step ticks.
field_water = {
	fill_rate_per_tick = 64
	still_ticks_to_sleep = 20
	minimum_fill = 8
	dry_ticks_per_step = 60
}
// The chunks every machine of a session simulates: this many chunks
// around each player's chunk across and up and down (work item 0177).
// Loading, the tick and the state hash all follow it.
simulated_chunk_radius_horizontal = 6
simulated_chunk_radius_vertical = 3
// The cell of a foundation frame in millimetres, from 250 to 2000 (work
// item 0174, doc/content.md, Foundations): a foundation is one cell thick
// and machines stand on its cells.
foundation_pitch_millimetres = 500
// The blocks a held foundation places at once (work item 0193,
// doc/content.md, Foundations): a square of size by size cells and height
// cells high, chosen on the inventory view with a foundation selected;
// the first of each list is a new player's. Each from 1 to 16 (at most
// 4096 cells a block), at most 16 entries.
foundation_sizes = [1, 2, 5, 10]
foundation_heights = [1, 2, 5]
// Free belt and pipe runs between poles (work item 0176, doc/content.md,
// Belt poles and runs): a run either inclines (its ends more than the
// level tolerance apart in height, its facings aligned) or turns (level,
// its facings turning up to the maximum), never both, and spans at most
// the maximum. The slope holds along the whole belt, not only the chord.
// An incline's facings and chord may turn up to aligned_degrees: at least
// half the 15 degree yaw step a new free pole is off the chord by, plus
// one. Span 1000 to 100000, slope 1 to 100, turn 15 to 135, tolerance 0
// to 1000, aligned 8 to 30.
belt_runs = {
	maximum_span_millimetres = 30000
	maximum_slope_percent = 70
	maximum_turn_degrees = 90
	level_tolerance_millimetres = 250
	aligned_degrees = 8
}
// The field session (work item 0179, doc/content.md, World): every
// machine simulates the terrain field's chunks within chunk_radius chunks
// of each player's chunk on each axis (a chunk is 32 samples, 32 m at
// 1000 mm and 10.7 m at 333 mm), and keeps the chunks it held within
// chunk_margin more, so a player walking along a chunk border does not
// unload and reload a slab each step. Radius 1 to 3, margin 0 to 2. Place
// with the torch item puts the torch emitter of data/lighting.sjson at
// the air in front of the targeted ground.
field_simulation = {
	chunk_radius = 2
	chunk_margin = 1
	torch_item = "torch"
	torch_emitter = "torch"
}
