	{
		id = "pod"
		name_key = "machine_pod"
		description_key = "describe_machine_pod"
		kind = "pod"
		stands_on_ground = true
		// 12 by 12 by 8 cells, the hull's bound (work item 0221): 6 by 6 by
		// 4 m at the 500 mm pitch; the width is the front axis, the outer
		// hatch on +x. The cells round the hull are its own for placement;
		// the player and the aiming ray meet the volumes of
		// models/pod.collision.sjson (0230).
		footprint = {width = 12, depth = 12, height = 8}
		model = "pod"
		// The free floor before the chair, 4 rows high (the first box:
		// players spawn at the centre of its floor, validate_pod_cabin),
		// the lane before the locker to the inner hatch, the airlock's
		// bore between the hatches (2 rows, crawled through crouched) and
		// the 2 rows outside the outer hatch.
		open_cells = [
			{from = {x = 3, y = 0, z = 4}, to = {x = 6, y = 3, z = 5}}
			{from = {x = 5, y = 0, z = 6}, to = {x = 6, y = 3, z = 7}}
			{from = {x = 8, y = 0, z = 5}, to = {x = 9, y = 1, z = 6}}
			{from = {x = 11, y = 0, z = 5}, to = {x = 11, y = 1, z = 6}}
		]
		// The outer hatch at the drum's outer end, the inner hatch at its
		// cabin end, then the locker facing the lane, the bench facing
		// the floor before the chair and the oxygen generator facing it
		// from the other side, each in its pocket of the wall.
		fixtures = [
			{machine = "pod_hatch", cell = {x = 10, y = 0, z = 5}, rotation = 0}
			{machine = "pod_hatch", cell = {x = 7, y = 0, z = 5}, rotation = 0}
			{machine = "pod_locker", cell = {x = 5, y = 0, z = 8}, rotation = 3}
			{machine = "crafting_bench", cell = {x = 2, y = 0, z = 4}, rotation = 0}
			{machine = "oxygen_generator", cell = {x = 6, y = 0, z = 3}, rotation = 1}
		]
		// The cabin and the hull at a quarter of the light round them (0225).
		interior_light_share = 0.25
		// The cabin's two lamps (0224, round three of the lab): the overhead
		// strip over the chair and the desk light, just under their lenses.
		lights = [
			{position = [-1.85, 5.315, 0.0], color = [255, 150, 40], radius_cells = 8.0}
			{position = [-2.35, 2.507, -2.674], color = [196, 228, 255], radius_cells = 3.5}
		]
	}
