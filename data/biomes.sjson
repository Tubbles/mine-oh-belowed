// Biomes (work items 0006 and 0058). A column takes the first biome whose
// ranges contain its surface height, its moisture and its temperature, so
// the order of the entries is the rule and the last entry should accept
// everything.
// minimum_height and maximum_height are inclusive, in blocks relative to
// sea level. Moisture comes from noise and lies between -1 and 1.
// Temperature lies between -1 (cold) and 1 (hot): a latitude band along z
// (cold towards -z, hot towards +z, temperate at the origin), noise, and a
// lapse with height (src/generation_terrain.odin). minimum_temperature and
// maximum_temperature are each optional: a missing bound accepts every
// temperature on its side.
// name_key names the biome on the map and the HUD banner, in
// data/strings/en.sjson. map_color tints the biome on the map.
// top_block is the surface block, filler_block the topsoil below it (three
// to five blocks, stone below that). layer_block (optional) alternates
// with the filler every layer_thickness blocks of absolute height, so
// cliffs show bands (badlands).
// tree_density and boulder_density are the chance, 0 to 1, that a feature
// cell holds a tree or a boulder rooted in this biome.
// trees (work item 0059) lists the species (data/trees.sjson) the
// biome's trees are drawn from, each with a whole number weight. A biome
// with a tree_density above 0 needs the list. clearing_share (optional, 0
// to 1, default 0) is about the share of the biome a clearing noise keeps
// free of trees, so forests have open patches and plains have groves.
// pit_block (optional, work item 0030) replaces top_block in the low spots
// of the biome: columns at most pit_maximum_height above sea level whose
// four neighbours stand no lower. The tar flats get tar pits.
// Work item 0057 added the mountains above the hills and the beaches at
// the shore. Beaches come after the tar flats and the desert, so tar pits
// and dry sand keep their shores. Work item 0058 added the climate biomes
// after the lake and the mountains. Highland comes before the hills and
// takes their wetter side; badlands take hot dry hills. Coastal dunes come
// after the beach, so the beach keeps the shore line and tar pits keep
// their low spots.
biomes = [
	{
		id = "lake"
		name_key = "biome_lake"
		minimum_height = -1000
		maximum_height = -1
		minimum_moisture = -1
		maximum_moisture = 1
		top_block = "sand"
		filler_block = "sand"
		tree_density = 0
