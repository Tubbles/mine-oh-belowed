# Throwaway and scratch files at the repository root (see CLAUDE.md,
# "Project structure"). Anchored so that doc/work/ stays tracked.
/tmp/
/work/

# Build output (build/) and the installed play build (bin/)
/build/
/bin/
/result
/result-*

# Python bytecode, wherever a script is imported from
__pycache__/

# Nix direnv
/.direnv/
